{
	"name": "@horon-ai/react",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"src",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts",
		"./globals.css": "./src/styles/globals.css",
		"./components/*": "./src/components/*.tsx",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@horon-ai/tokens": "workspace:*",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-table": "^9.3.1",
		"pretendard": "^1.3.9",
		"tailwind-merge": "^3.7.0"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4",
		"typescript": "~6.0.3"
	}
}
