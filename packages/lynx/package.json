{
  "name": "@horon-ai/lynx",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horon-ai/design.git",
    "directory": "packages/lynx"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "tailwind-preset.cjs",
    "tailwind-preset.d.cts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./tokens.css": "./src/styles/tokens.css",
    "./globals.css": "./src/styles/globals.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p .",
    "test": "rstest run",
    "build": "rspeedy build",
    "dev": "rspeedy dev",
    "integrate": "bun scripts/integrate.ts",
    "gallery:web": "bun scripts/serve-web.ts",
    "tokens": "bun scripts/generate-tokens.ts",
    "icons": "bun scripts/generate-icons.ts"
  },
  "dependencies": {
    "@horon-ai/tokens": "workspace:*",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.129.0"
  },
  "devDependencies": {
    "@lynx-js/react": "^0.129.2",
    "@lynx-js/react-rsbuild-plugin": "^0.22.2",
    "@lynx-js/rspeedy": "^0.18.5",
    "@lynx-js/tailwind-preset": "^0.6.0",
    "@lynx-js/types": "^4.4.2",
    "@lynx-js/web-core": "^0.26.7",
    "@lynx-js/web-elements": "^0.12.17",
    "@phosphor-icons/core": "^2.1.1",
    "@rsbuild/core": "^2.3.1",
    "@rstest/core": "^0.12.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "preact": "npm:@lynx-js/internal-preact@11.0.0-rc.1-20260903085447-f95471a"
  }
}
