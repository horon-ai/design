{
	"name": "@horon/app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./theme": "./src/theme/index.ts",
		"./primitives/*": "./src/primitives/*.tsx",
		"./components/*": "./src/components/*.tsx",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@horon/tokens": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-native": ">=0.74"
	},
	"devDependencies": {
		"@types/react": "^19",
		"react": "^19.3.0",
		"react-native": "^0.87.1",
		"react-native-web": "^0.21.4",
		"typescript": "~6.0.3"
	}
}
