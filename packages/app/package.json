{
	"name": "@horon/app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./theme": "./src/theme/index.ts",
		"./primitives/*": "./src/primitives/*.tsx",
		"./components/*": "./src/components/*.tsx",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "eslint",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@horon/tokens": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-native": ">=0.74"
	},
	"devDependencies": {
		"@eslint/js": "^10",
		"@types/react": "^19",
		"eslint": "^10",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17",
		"react": "^19.3.0",
		"react-native": "^0.87.1",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8"
	}
}
