{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "customConditions": ["react-native"],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts"],
  "exclude": ["node_modules"]
}
