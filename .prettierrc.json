{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 120,
  "overrides": [
    {
      "files": "package.json",
      "options": {
        "useTabs": true
      }
    }
  ],
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "packages/react/src/styles/globals.css",
  "tailwindFunctions": ["cn", "cva"]
}
