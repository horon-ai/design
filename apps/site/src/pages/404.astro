---
import { Button, Card, EmptyState } from "@horon-ai/react";
import { createElement, Fragment, type ReactNode } from "react";

import T from "@/components/i18n/T.astro";
import { componentGroups, componentsInGroup } from "@/data/components";
import { mascotImageUrl } from "@/data/mascots";
import type { Localized } from "@/i18n";
import { notFoundMessages as m } from "@/i18n/messages/not-found";
import BaseLayout from "@/layouts/BaseLayout.astro";

const suggestions = componentGroups.map((group) => ({
  title: group.title,
  items: componentsInGroup(group.id).slice(0, 4),
}));

/** React nodes for library props, using the same two-span markup as `T.astro`. */
function localized(entry: Localized): ReactNode {
  return createElement(
    Fragment,
    null,
    createElement("span", { "data-locale-text": "ko", lang: "ko" }, entry.ko),
    createElement("span", { "data-locale-text": "en", lang: "en" }, entry.en),
  );
}

const illustration = createElement("img", {
  src: mascotImageUrl("lost"),
  alt: m.lostAlt.ko,
  width: 180,
  height: 180,
  className: "object-contain",
});

const actions = createElement(
  "div",
  { className: "flex flex-wrap items-center justify-center gap-3" },
  createElement(
    Button,
    { variant: "primary", href: "/" },
    localized(m.home),
  ),
  createElement(
    Button,
    { variant: "glass", href: "/components" },
    localized(m.components),
  ),
);
---

<BaseLayout title={m.title} description={m.description}>
  <div class="mx-auto w-full max-w-275 px-4 py-24 md:px-6">
    <h1 class="sr-only"><T m={m.title} /></h1>
    <div class="flex justify-center">
      <EmptyState
        className="w-full max-w-90"
        illustration={illustration}
        title={localized(m.title)}
        description={localized(m.body)}
        action={actions}
      />
    </div>

    <div class="mt-14 grid gap-6 border-t border-border-default pt-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        suggestions.map((group) => (
          <Card title={localized(group.title)}>
            <ul class="space-y-1">
              {group.items.map((component) => (
                <li>
                  <Button
                    variant="link"
                    href={`/components/${component.slug}`}
                  >
                    <T m={component.title} />
                  </Button>
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </div>
</BaseLayout>
