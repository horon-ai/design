---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { componentGroups, componentsInGroup } from "@/data/components";
import { mascotImageUrl } from "@/data/mascots";

const suggestions = componentGroups.map((group) => ({
  title: group.title,
  items: componentsInGroup(group.id).slice(0, 4),
}));
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 문서가 없습니다.">
  <div class="site-shell py-24">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div>
        <h1 class="doc-title">페이지를 찾을 수 없습니다</h1>
        <p class="doc-lead mt-4">
          주소가 바뀌었거나 아직 없는 문서입니다. 아래에서 원하는 항목을 다시 찾아보세요.
        </p>
      </div>
      <img
        src={mascotImageUrl("lost")}
        alt="길을 잃은 Horon 마스코트"
        width="180"
        height="180"
        class="size-[140px] shrink-0 object-contain sm:size-[180px]"
      />
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex h-[37px] items-center rounded-md bg-interactive-primary px-5 text-[13.5px] font-semibold text-interactive-on-primary transition-opacity hover:opacity-85"
      >
        홈으로
      </a>
      <a
        href="/components"
        class="inline-flex h-[37px] items-center rounded-md border border-border-default px-5 text-[13.5px] font-medium transition-colors hover:bg-bg-subtle"
      >
        컴포넌트 목록
      </a>
    </div>

    <div class="mt-14 grid gap-6 border-t border-border-default pt-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        suggestions.map((group) => (
          <div class="rounded-xl bg-bg-subtle/40 px-5 py-5">
            <p class="text-caption text-text-secondary">{group.title}</p>
            <ul class="mt-2 space-y-1">
              {group.items.map((component) => (
                <li>
                  <a
                    href={`/components/${component.slug}`}
                    class="text-[13px] text-text-secondary transition-colors hover:text-text-primary"
                  >
                    {component.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
