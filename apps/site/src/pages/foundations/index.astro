---
import { ComponentCard } from "@/components/site/ComponentCard";
import T from "@/components/i18n/T.astro";
import { foundationsNav } from "@/data/nav";
import { fill } from "@/i18n/messages/fill";
import { foundationsIndexMessages as m } from "@/i18n/messages/foundations-index";
import DocsLayout from "@/layouts/DocsLayout.astro";

const items = [
  { href: "/foundations/tokens", title: m.designTokenTitle, description: m.designTokenBody },
  { href: "/foundations/color", title: m.colorTitle, description: m.colorBody },
  {
    href: "/foundations/typography",
    title: m.typographyTitle,
    description: m.typographyBody,
  },
  { href: "/foundations/spacing", title: m.spacingTitle, description: m.spacingBody },
  { href: "/foundations/radius", title: m.radiusTitle, description: m.radiusBody },
  { href: "/foundations/glass", title: m.glassTitle, description: m.glassBody },
];

const listCount = fill(m.count, { count: foundationsNav.length - 1 });
---

<DocsLayout
  title={m.title}
  section="foundations"
  description={m.description}
>
  <p><T m={m.intro} /></p>

  <div class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      items.map((item) => (
        <ComponentCard
          href={item.href}
          title={item.title}
          description={item.description}
        />
      ))
    }
  </div>

  <h2><T m={m.flowHeading} /></h2>
  <p><T m={m.flowBody} /></p>
  <p><T m={listCount} /></p>
</DocsLayout>
