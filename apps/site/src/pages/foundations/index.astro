---
import CatalogTile from "@/components/site/CatalogTile.astro";
import FoundationThumbnail, { type FoundationThumbnailId } from "@/components/site/FoundationThumbnail.astro";
import { foundationsIndexMessages as m } from "@/i18n/messages/foundations-index";
import type { Localized } from "@/i18n";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { siteHref } from "@/lib/urls";

const items: { id: FoundationThumbnailId; href: string; title: Localized }[] = [
  { id: "tokens", href: "/foundations/tokens", title: m.designTokenTitle },
  { id: "color", href: "/foundations/color", title: m.colorTitle },
  { id: "typography", href: "/foundations/typography", title: m.typographyTitle },
  { id: "spacing", href: "/foundations/spacing", title: m.spacingTitle },
  { id: "radius", href: "/foundations/radius", title: m.radiusTitle },
  { id: "glass", href: "/foundations/glass", title: m.glassTitle },
];
---

<DocsLayout title={m.title} section="foundations" description={m.description} wide>
  <ul class="catalog-grid not-prose">
    {
      items.map((item) => (
        <CatalogTile href={siteHref(item.href)} title={item.title}>
          <FoundationThumbnail id={item.id} />
        </CatalogTile>
      ))
    }
  </ul>
</DocsLayout>
