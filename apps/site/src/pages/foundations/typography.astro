---
import {
  DataTable,
  DataTableCell,
  DataTableHead,
  DataTableRow,
  DataTableTable,
} from "@horon-ai/react";
import { fontFamily, fontWeight, platforms, textStyles } from "@horon-ai/tokens";

import T from "@/components/i18n/T.astro";
import { fill } from "@/i18n/messages/fill";
import { foundationsTypographyMessages as m } from "@/i18n/messages/foundations-typography";
import DocsLayout from "@/layouts/DocsLayout.astro";

/** Each style rendered as itself. The class names stay literal so Tailwind sees them. */
const specimenClass: Record<string, string> = {
  "display-lg": "text-display-lg",
  "display-md": "text-display-md",
  "title-lg": "text-title-lg",
  "title-md": "text-title-md",
  "title-sm": "text-title-sm",
  "body-lg": "text-body-lg",
  "body-md": "text-body-md",
  "body-sm": "text-body-sm",
  "label-lg": "text-label-lg",
  "label-md": "text-label-md",
  "label-sm": "text-label-sm",
  caption: "text-caption",
  code: "text-code font-mono",
};

const styles = Object.entries(textStyles);
const weights = Object.entries(fontWeight)
  .map(([name, value]) => `${name} ${value}`)
  .join(", ");
const fontLine = fill(m.fontBody, {
  sans: fontFamily.sans[0],
  mono: fontFamily.mono[0],
  weights,
});
---

<DocsLayout
  title={m.title}
  eyebrow="Foundations"
  section="foundations"
  description={m.description}
>
  <h2><T m={m.fontHeading} /></h2>
  <p><T m={fontLine} /></p>

  <h2><T m={m.stylesHeading} /></h2>
  <p><T m={m.stylesBody} /></p>
  <DataTable className="mt-5">
    <DataTableTable>
      <thead>
        <DataTableRow>
          <DataTableHead><T m={m.headStyle} /></DataTableHead>
          {platforms.map((platform) => <DataTableHead>{platform}</DataTableHead>)}
          <DataTableHead><T m={m.headWeight} /></DataTableHead>
        </DataTableRow>
      </thead>
      <tbody>
        {
          styles.map(([name, style]) => (
            <DataTableRow>
              <DataTableCell>
                <span class={specimenClass[name] ?? "text-body-md"}>{name}</span>
              </DataTableCell>
              {platforms.map((platform) => (
                <DataTableCell>
                  <span class="font-mono text-caption">
                    {style.size[platform]} / {style.lineHeight[platform]}
                  </span>
                </DataTableCell>
              ))}
              <DataTableCell>
                <span class="font-mono text-caption">
                  {fontWeight[style.weight]} · {style.tracking}em
                </span>
              </DataTableCell>
            </DataTableRow>
          ))
        }
      </tbody>
    </DataTableTable>
  </DataTable>

  <h2><T m={m.rulesHeading} /></h2>
  <ul>
    <li><T m={m.ruleStyles} /></li>
    <li><T m={m.ruleParagraph} /></li>
    <li><T m={m.ruleWrap} /></li>
  </ul>
</DocsLayout>
