---
import { darkColors, lightColors, primitives } from "@horon-ai/tokens";

import T from "@/components/i18n/T.astro";
import { foundationsColorMessages as m } from "@/i18n/messages/foundations-color";
import DocsLayout from "@/layouts/DocsLayout.astro";

const groups = [
  { title: m.backgroundGroup, prefix: "bg-" },
  { title: m.surfaceGroup, prefix: "surface-" },
  { title: m.textGroup, prefix: "text-" },
  { title: m.borderGroup, prefix: "border-" },
  { title: m.interactiveGroup, prefix: "interactive-" },
  { title: m.statusGroup, prefix: "status-" },
  { title: m.glassGroup, prefix: "glass-" },
  { title: m.overlayGroup, prefix: "overlay-" },
  { title: m.accentGroup, prefix: "accent-" },
  { title: m.syntaxGroup, prefix: "syntax-" },
];

const names = Object.keys(lightColors) as (keyof typeof lightColors)[];
const dark = darkColors as Record<string, string>;
---

<DocsLayout
  title={m.title}
  eyebrow="Foundations"
  section="foundations"
  description={m.description}
>
  <p><T m={m.intro} /></p>

  <h2><T m={m.primitivesHeading} /></h2>
  <p><T m={m.primitivesBody} /></p>
  <div class="mt-5 grid grid-cols-2 overflow-hidden rounded-xl border border-border-default sm:grid-cols-4">
    {
      Object.entries(primitives).map(([name, value]) => (
        <div class="border-r border-b border-border-default">
          <div class="h-14" style={`background: ${value}`} aria-hidden="true" />
          <div class="px-3 py-2">
            <p class="font-mono text-caption text-text-primary">{name}</p>
            <p class="font-mono text-caption text-text-secondary">{value}</p>
          </div>
        </div>
      ))
    }
  </div>

  {
    groups.map((group) => (
      <>
        <h2><T m={group.title} /></h2>
        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          {names
            .filter((name) => name.startsWith(group.prefix))
            .map((name) => (
              <div class="flex items-center gap-3 rounded-lg bg-bg-subtle px-3 py-2">
                <span
                  class="flex size-8 shrink-0 overflow-hidden rounded-xs border border-border-default"
                  aria-hidden="true"
                >
                  <span class="flex-1" style={`background: ${lightColors[name]}`} />
                  <span class="flex-1" style={`background: ${dark[name] ?? lightColors[name]}`} />
                </span>
                <span class="min-w-0">
                  <span class="block truncate font-mono text-caption text-text-primary">
                    --color-{name}
                  </span>
                  <span class="block font-mono text-caption text-text-secondary">
                    {lightColors[name]} · {dark[name] ?? "—"}
                  </span>
                </span>
              </div>
            ))}
        </div>
      </>
    ))
  }
</DocsLayout>
