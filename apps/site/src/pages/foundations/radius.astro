---
import { radius, shadow } from "@horon-ai/tokens";

import T from "@/components/i18n/T.astro";
import { foundationsRadiusMessages as m } from "@/i18n/messages/foundations-radius";
import DocsLayout from "@/layouts/DocsLayout.astro";
---

<DocsLayout
  title={m.title}
  section="foundations"
  description={m.description}
>
  <h2><T m={m.radiusHeading} /></h2>
  <div class="mt-5 flex flex-wrap gap-4 rounded-xl border border-border-default bg-bg-subtle p-5">
    {
      Object.entries(radius).map(([name, value]) => (
        <div class="flex flex-col items-center gap-2">
          <div
            class="size-20 border border-border-strong bg-bg-subtle"
            style={`border-radius: ${Math.min(value, 40)}px`}
            aria-hidden="true"
          />
          <span class="font-mono text-caption text-text-secondary">{name} · {value}</span>
        </div>
      ))
    }
  </div>
  <p><T m={m.radiusNote} /></p>

  <h2><T m={m.shadowHeading} /></h2>
  <p><T m={m.shadowBody} /></p>
  <div class="mt-5 grid gap-6 sm:grid-cols-2">
    {
      Object.entries(shadow).map(([name, value]) => (
        <div class="rounded-xl border border-border-default bg-bg-subtle p-8">
          <div
            class="flex h-24 items-center justify-center rounded-xl bg-bg-surface"
            style={`box-shadow: ${value}`}
          >
            <span class="font-mono text-caption text-text-secondary">shadow-{name}</span>
          </div>
          <p class="mt-3 font-mono text-caption text-text-secondary">{value}</p>
        </div>
      ))
    }
  </div>
</DocsLayout>
