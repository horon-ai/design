---
import { spacing } from "@horon-ai/tokens";

import T from "@/components/i18n/T.astro";
import { foundationsSpacingMessages as m } from "@/i18n/messages/foundations-spacing";
import DocsLayout from "@/layouts/DocsLayout.astro";

const steps = Object.entries(spacing);
---

<DocsLayout
  title={m.title}
  section="foundations"
  description={m.description}
>
  <div class="flex flex-col gap-2">
    {
      steps.map(([step, value]) => (
        <div class="flex items-center gap-4">
          <span class="w-24 shrink-0 font-mono text-caption text-text-secondary">spacing-{step}</span>
          <span class="h-4 rounded-xs bg-sky-500" style={`width: ${value * 4}px`} />
          <span class="font-mono text-caption text-text-primary">{value}px</span>
        </div>
      ))
    }
  </div>
  <p><T m={m.barNote} /></p>
</DocsLayout>
