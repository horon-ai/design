---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { spacing } from "@horon-ai/tokens";
---

<DocsLayout
  title="Spacing"
  eyebrow="Foundations"
  section="foundations"
  description="Figma Scale 컬렉션의 간격 값입니다. Tailwind의 4px 기본 단위와 같아서 p-3, gap-1.5 같은 클래스가 그대로 맞습니다."
>
  <div class="not-prose mt-5 flex flex-col gap-2">
    {
      Object.entries(spacing).map(([step, value]) => (
        <div class="flex items-center gap-4">
          <span class="w-24 shrink-0 font-mono text-caption text-text-secondary">spacing-{step}</span>
          <span class="h-4 rounded-[3px] bg-sky-500" style={`width: ${value * 4}px`} />
          <span class="font-mono text-caption text-text-primary">{value}px</span>
        </div>
      ))
    }
  </div>
  <p>막대 길이는 보기 쉽게 실제 값의 4배로 그렸습니다.</p>
</DocsLayout>
