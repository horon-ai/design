---
import DocsLayout from "@/layouts/DocsLayout.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import { text, radius, space, shadow, duration, glassBlur } from "@horon/tokens";

const groups = [
  {
    name: "Color",
    source: "src/palette.ts · src/tokens.ts",
    output: "--background, --foreground, --card, --primary, --ring, …",
    count: "36 시맨틱 × 2 모드",
  },
  {
    name: "Radius",
    source: "src/scales.ts",
    output: `--radius-xs … --radius-4xl (${Object.values(radius).length}단)`,
    count: `${Object.keys(radius).length} 값`,
  },
  {
    name: "Spacing",
    source: "src/scales.ts",
    output: `space 0 … 24 (${Object.keys(space).length}단)`,
    count: `${Object.keys(space).length} 값`,
  },
  {
    name: "Text",
    source: "src/scales.ts",
    output: `--text-caption … --text-hero (${Object.keys(text).length}단)`,
    count: `${Object.keys(text).length} 값`,
  },
  {
    name: "Elevation",
    source: "src/scales.ts",
    output: `--shadow-sm, --shadow-md, --shadow-lg`,
    count: `${Object.keys(shadow).length} 값`,
  },
  {
    name: "Motion",
    source: "src/scales.ts",
    output: `--duration-* (${Object.keys(duration).length}단), --ease-*`,
    count: `${Object.keys(duration).length} 지속 시간`,
  },
  {
    name: "Glass",
    source: "src/scales.ts · src/tokens.ts",
    output: `--glass-fill, --glass-border, --glass-blur (${glassBlur}px), --glass-liquid-*`,
    count: "7 값 × 2 모드",
  },
];

const usage = `// 웹: 생성된 CSS를 그대로 import
import "@horon/web/globals.css";

// 네이티브: 같은 값을 hex·숫자로
import { colors, space, radius } from "@horon/tokens/native";

// 원시 값이 필요할 때
import { PALETTE, ACCENT, INK } from "@horon/tokens";`;
---

<DocsLayout
  title="Design Token"
  eyebrow="Foundations"
  section="foundations"
  description="토큰은 이 시스템의 단일 소스입니다. 색·간격·반경·타이포·모션·유리 표면의 값이 여기 한 번만 적히고, 웹 CSS와 네이티브 값이 여기서 파생됩니다."
>
  <p>
    <code>@horon/tokens</code>는 TypeScript 소스에서 <code>theme.css</code>를 생성합니다. 생성 파일에는
    자동 생성 헤더가 붙고, 손으로 고치지 않습니다. 값을 바꾸려면 소스를 고치고 다시 빌드합니다.
  </p>

  <CodeBlock code="bun run --filter @horon/tokens build" lang="bash" title="terminal" />

  <h2>무엇이 나오나</h2>
  <div class="not-prose mt-5 overflow-hidden rounded-md border border-border">
    <table class="w-full text-left text-[12.5px]">
      <thead class="border-b border-border bg-muted/50 text-muted-foreground">
        <tr>
          <th class="px-4 py-2 font-medium">그룹</th>
          <th class="px-4 py-2 font-medium">소스</th>
          <th class="px-4 py-2 font-medium">출력</th>
        </tr>
      </thead>
      <tbody>
        {
          groups.map((group) => (
            <tr class="border-b border-border align-top last:border-b-0">
              <td class="px-4 py-2.5 font-medium">{group.name}</td>
              <td class="px-4 py-2.5 font-mono text-[11px] text-muted-foreground">{group.source}</td>
              <td class="px-4 py-2.5 font-mono text-[11px] text-muted-foreground">
                {group.output}
                <span class="mt-1 block text-[10.5px] opacity-70">{group.count}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>세 층</h2>
  <ol>
    <li><strong>프리미티브</strong> — <code>sand-100…1200</code>, <code>gold-100…600</code>, 상태색. 모드와 무관한 단일 값입니다.</li>
    <li><strong>시맨틱</strong> — <code>background</code>, <code>card</code>, <code>primary</code>, <code>ring</code> 등. 라이트·다크 두 벌이 있습니다.</li>
    <li><strong>스케일</strong> — 간격, 반경, 타이포, 그림자, 모션, 유리. 모드와 무관합니다.</li>
  </ol>

  <h2>소비</h2>
  <CodeBlock code={usage} title="tsx" />

  <h2>드리프트 가드</h2>
  <p>
    <code>bun test</code>가 생성된 CSS와 소스의 값이 어긋나면 실패합니다. 팔레트 각 단계는 캔버스의
    hex로 왕복 단언되므로, 값을 손으로 바꾸면 테스트가 먼저 알려 줍니다.
  </p>
</DocsLayout>
