---
import {
  DataTable,
  DataTableCell,
  DataTableHead,
  DataTableRow,
  DataTableTable,
} from "@horon-ai/react";
import { lightColors, primitives, radius, shadow, spacing, textStyles } from "@horon-ai/tokens";

import CodeBlock from "@/components/site/CodeBlock.astro";
import T from "@/components/i18n/T.astro";
import { fill } from "@/i18n/messages/fill";
import { foundationsTokensMessages as m } from "@/i18n/messages/foundations-tokens";
import DocsLayout from "@/layouts/DocsLayout.astro";

const rows = [
  {
    file: "color.ts",
    body: m.colorBody,
    count: fill(m.colorCount, {
      semantic: Object.keys(lightColors).length,
      primitive: Object.keys(primitives).length,
    }),
    source: m.colorSource,
  },
  {
    file: "typography.ts",
    body: m.typographyBody,
    count: fill(m.typographyCount, { styles: Object.keys(textStyles).length }),
    source: m.typographySource,
  },
  {
    file: "scale.ts",
    body: m.scaleBody,
    count: fill(m.scaleCount, {
      spacing: Object.keys(spacing).length,
      radius: Object.keys(radius).length,
      shadow: Object.keys(shadow).length,
    }),
    source: m.scaleSource,
  },
  {
    file: "glass.ts",
    body: m.glassBody,
    count: m.glassCount,
    source: m.glassSource,
  },
];

const build = `# from the repository root
bun run --filter @horon-ai/tokens build   # regenerate packages/tokens/theme.css
bun test packages/tokens                  # check the output matches the committed file`;

const usage = `<p class="text-label-md text-text-secondary">Label</p>
<div class="rounded-xl bg-glass-thick" />
<span style="color: var(--color-text-brand)">Brand</span>`;
---

<DocsLayout
  title={m.title}
  section="foundations"
  description={m.description}
>
  <h2><T m={m.filesHeading} /></h2>
  <DataTable className="mt-5">
    <DataTableTable>
      <thead>
        <DataTableRow>
          <DataTableHead><T m={m.headFile} /></DataTableHead>
          <DataTableHead><T m={m.headBody} /></DataTableHead>
          <DataTableHead><T m={m.headCount} /></DataTableHead>
          <DataTableHead><T m={m.headSource} /></DataTableHead>
        </DataTableRow>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <DataTableRow>
              <DataTableCell>
                <code class="font-mono text-code text-text-primary">{row.file}</code>
              </DataTableCell>
              <DataTableCell><T m={row.body} /></DataTableCell>
              <DataTableCell><T m={row.count} /></DataTableCell>
              <DataTableCell><T m={row.source} /></DataTableCell>
            </DataTableRow>
          ))
        }
      </tbody>
    </DataTableTable>
  </DataTable>

  <h2><T m={m.namingHeading} /></h2>
  <p><T m={m.namingBody} /></p>
  <CodeBlock code={usage} title="html" />

  <h2><T m={m.rebuildHeading} /></h2>
  <p><T m={m.rebuildBody} /></p>
  <CodeBlock code={build} lang="bash" title="terminal" />
</DocsLayout>
