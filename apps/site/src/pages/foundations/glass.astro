---
import { Button } from "@horon-ai/react";
import { glass } from "@horon-ai/tokens";

import CodeBlock from "@/components/site/CodeBlock.astro";
import GlassDemo from "@/components/demo-wrappers/liquid-glass.astro";
import T from "@/components/i18n/T.astro";
import { fill } from "@/i18n/messages/fill";
import { foundationsGlassMessages as m } from "@/i18n/messages/foundations-glass";
import DocsLayout from "@/layouts/DocsLayout.astro";

const layers = fill(m.layersBody, { opacity: glass.layerOpacity * 100 });
const tint = fill(m.tintItem, { color: glass.tint.color, blur: glass.tint.blur });
const innerShade = fill(m.innerShadeItem, {
  color: glass.innerShade.color,
  blur: glass.innerShade.blur,
  maxY: glass.innerShade.maxInsetY,
  maxX: glass.innerShade.maxInsetX,
});
const edge = fill(m.edgeItem, { color: glass.edgeLightSoft.color });

const usage = `import { LiquidGlass } from "@horon-ai/react";

<div className="relative overflow-clip rounded-xl bg-glass-thick p-5">
  <LiquidGlass tier="thick" />
  <p className="relative">Content</p>
</div>`;
---

<DocsLayout
  title={m.title}
  eyebrow="Foundations"
  section="foundations"
  description={m.description}
>
  <div class="mt-2"><GlassDemo /></div>

  <h2><T m={m.layersHeading} /></h2>
  <p><T m={layers} /></p>
  <ul>
    <li><T m={tint} /></li>
    <li><T m={innerShade} /></li>
    <li><T m={edge} /></li>
    <li><T m={m.textureItem} /></li>
  </ul>
  <p><T m={m.heightNote} /></p>

  <h2><T m={m.refractionHeading} /></h2>
  <p><T m={m.refractionBody} /></p>
  <p>
    <T m={m.refractionFallbackLead} /><Button
      variant="link"
      href="https://bugs.webkit.org/show_bug.cgi?id=245510"
      target="_blank"
      rel="noreferrer"
    >WebKit 245510</Button>, <Button
      variant="link"
      href="https://bugzilla.mozilla.org/show_bug.cgi?id=1961378"
      target="_blank"
      rel="noreferrer"
    >Gecko 1961378</Button><T m={m.refractionFallbackTail} />
  </p>
  <ul>
    <li><T m={m.ruleLimit} /></li>
    <li><T m={m.ruleOffscreen} /></li>
    <li><T m={m.ruleReducedTransparency} /></li>
    <li><T m={m.ruleRefractOff} /></li>
  </ul>

  <h2><T m={m.usageHeading} /></h2>
  <CodeBlock code={usage} title="tsx" />
</DocsLayout>
