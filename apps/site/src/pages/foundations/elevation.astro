---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { shadow } from "@horon-ai/tokens";

const shadows = Object.entries(shadow);
const rules = [
  ["떠 있는 chrome", "dialog, sheet, popover, dropdown, tooltip", "shadow-lg 또는 유리 표면"],
  ["일시적 알림", "toast, sonner", "shadow-md"],
  ["고정 요소", "sticky 헤더", "그림자 대신 아래쪽 헤어라인"],
  ["일반 콘텐츠", "card, list, table", "그림자 없이 테두리"],
];
---

<DocsLayout
  title="Elevation"
  eyebrow="Foundations"
  section="foundations"
  description="높이는 그림자 3단으로만 표현합니다. 콘텐츠 표면은 그림자를 쓰지 않고, 실제로 화면 위에 떠 있는 표면만 높이를 갖습니다."
>
  <p>
    그림자는 계층을 알리는 신호입니다. 페이지 흐름 안에 놓인 카드와 표에는 그림자를 주지 않고
    테두리로 구획합니다. 그림자를 남발하면 어느 표면이 실제로 떠 있는지 읽히지 않습니다.
  </p>

  <h2>스케일</h2>
  <div class="not-prose mt-5 grid gap-5 sm:grid-cols-3">
    {
      shadows.map(([name, value]) => (
        <div>
          <div
            class="rounded-md border border-border bg-card px-4 py-8"
            style={`box-shadow: ${value.web}`}
          >
            <p class="font-mono text-[11px]">shadow-{name}</p>
          </div>
          <p class="mt-2 font-mono text-[10px] leading-4 text-muted-foreground">{value.web}</p>
        </div>
      ))
    }
  </div>

  <h2>언제 쓰나</h2>
  <div class="not-prose mt-5 overflow-hidden rounded-md border border-border">
    <table class="w-full text-left text-[12.5px]">
      <thead class="border-b border-border bg-muted/50 text-muted-foreground">
        <tr>
          <th class="px-4 py-2 font-medium">표면</th>
          <th class="px-4 py-2 font-medium">예</th>
          <th class="px-4 py-2 font-medium">처리</th>
        </tr>
      </thead>
      <tbody>
        {
          rules.map(([surface, example, rule]) => (
            <tr class="border-b border-border last:border-b-0">
              <td class="px-4 py-2">{surface}</td>
              <td class="px-4 py-2 font-mono text-[11px] text-muted-foreground">{example}</td>
              <td class="px-4 py-2 text-muted-foreground">{rule}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

</DocsLayout>
