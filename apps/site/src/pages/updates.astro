---
import T from "@/components/i18n/T.astro";
import type { Localized } from "@/i18n";
import { updatesMessages as m } from "@/i18n/messages/updates";
import DocsLayout from "@/layouts/DocsLayout.astro";

const releases: { date: string; title: Localized; items: Localized[] }[] = [
  {
    date: "2026-11-06",
    title: m.brandTitle,
    items: [m.brandItem1, m.brandItem2, m.brandItem3],
  },
  {
    date: "2026-10-26",
    title: m.figmaTitle,
    items: [m.figmaItem1, m.figmaItem2, m.figmaItem3, m.figmaItem4],
  },
  {
    date: "2026-10-20",
    title: m.publicTitle,
    items: [m.publicItem1, m.publicItem2, m.publicItem3],
  },
  {
    date: "2026-10-14",
    title: m.parityTitle,
    items: [m.parityItem1, m.parityItem2, m.parityItem3],
  },
  {
    date: "2026-10-14",
    title: m.canvasTitle,
    items: [m.canvasItem1, m.canvasItem2, m.canvasItem3],
  },
];
---

{/* Release notes as plain filled cards, the same surface as the Get Started link
    tiles: date, title, then the changes in small text. */}
<DocsLayout title={m.title} section="updates" description={m.description} toc={false}>
  <h2><T m={m.releaseNotesTitle} /></h2>
  <ol class="not-prose grid list-none gap-3 p-0 md:grid-cols-2">
    {
      releases.map((release) => (
        <li class="flex flex-col gap-2 rounded-xl bg-bg-subtle px-5 py-4">
          <time datetime={release.date} class="text-caption text-text-secondary">
            {release.date.replaceAll("-", ". ")}
          </time>
          <h3 class="text-label-lg text-text-primary">
            <T m={release.title} />
          </h3>
          <ul class="flex flex-col gap-1.5">
            {release.items.map((item) => (
              <li class="text-body-sm text-text-secondary">
                <T m={item} />
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</DocsLayout>
