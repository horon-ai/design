---
import T from "@/components/i18n/T.astro";
import type { Localized } from "@/i18n";
import { updatesMessages as m } from "@/i18n/messages/updates";
import DocsLayout from "@/layouts/DocsLayout.astro";

const releases: { date: string; title: Localized; items: Localized[] }[] = [
  {
    date: "2026-11-06",
    title: m.brandTitle,
    items: [m.brandItem1, m.brandItem2, m.brandItem3],
  },
  {
    date: "2026-10-26",
    title: m.figmaTitle,
    items: [m.figmaItem1, m.figmaItem2, m.figmaItem3, m.figmaItem4],
  },
  {
    date: "2026-10-20",
    title: m.publicTitle,
    items: [m.publicItem1, m.publicItem2, m.publicItem3],
  },
  {
    date: "2026-10-14",
    title: m.parityTitle,
    items: [m.parityItem1, m.parityItem2, m.parityItem3],
  },
  {
    date: "2026-10-14",
    title: m.canvasTitle,
    items: [m.canvasItem1, m.canvasItem2, m.canvasItem3],
  },
];
---

<DocsLayout title={m.title} section="updates" description={m.description}>
  <ol class="mt-2 list-none space-y-10 pl-0">
    {
      releases.map((release) => (
        <li class="border-l border-border-default pl-6">
          <p class="text-caption text-text-secondary">{release.date}</p>
          <h2 class="mt-2 text-title-sm">
            <T m={release.title} />
          </h2>
          <ul class="mt-3 space-y-1.5">
            {release.items.map((item) => (
              <li class="text-body-sm text-text-secondary">
                <T m={item} />
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</DocsLayout>
