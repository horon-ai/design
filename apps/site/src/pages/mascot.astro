---
import { Button, HoronWordmark } from "@horon-ai/react";
import { Fragment } from "react";

import T from "@/components/i18n/T.astro";
import {
  coreMascots,
  mascotImageUrl,
  mascotPalette,
  mascotSourceUrl,
  stateMascots,
} from "@/data/mascots";
import { mascotMessages as m } from "@/i18n/messages/mascot";
import DocsLayout from "@/layouts/DocsLayout.astro";

const groups = [
  { title: m.coreTitle, description: m.coreDescription, items: coreMascots },
  { title: m.stateTitle, description: m.stateDescription, items: stateMascots },
];

const logoScales = [
  { size: 24, className: "size-6" },
  { size: 32, className: "size-8" },
  { size: 48, className: "size-12" },
  { size: 64, className: "size-16" },
];

const swatchClass: Record<string, string> = {
  ink: "bg-mascot-ink",
  cream: "bg-mascot-cream",
  gold: "bg-mascot-gold",
};

const rules = [m.rule1, m.rule2, m.rule3, m.rule4, m.rule5];

---

<DocsLayout title={m.pageTitle} description={m.description} section="mascot">
  <p><T m={m.body} /></p>

  <h2><T m={m.appliedTitle} /></h2>
  <p><T m={m.appliedBody} /></p>
  <div class="grid items-start gap-4 md:grid-cols-2">
    <section class="not-prose rounded-xl bg-bg-subtle p-6">
      <h3 class="mb-4 text-label-lg text-text-primary"><T m={m.lockupTitle} /></h3>
      <div class="flex items-center gap-2.5">
        <img src={mascotImageUrl("face")} alt="" width="30" height="30" class="size-8 object-contain dark:rounded-full dark:bg-sky-100 dark:p-0.5" />
        <HoronWordmark />
        <span class="text-body-sm text-text-secondary"><T m={m.designSystem} /></span>
      </div>
      <div class="mt-5 flex items-end gap-4">
        {
          logoScales.map((logo) => (
            <div class="flex flex-col items-center gap-1.5">
              <img
                src={mascotImageUrl("face")}
                alt={`${logo.size}${m.logoAlt.ko}`}
                width={logo.size}
                height={logo.size}
                class:list={["object-contain dark:rounded-full dark:bg-sky-100 dark:p-0.5", logo.className]}
              />
              <span class="text-caption text-text-secondary">{logo.size}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="not-prose rounded-xl bg-bg-subtle p-6">
      <h3 class="mb-4 text-label-lg text-text-primary"><T m={m.faviconTitle} /></h3>
      <div class="flex flex-wrap items-center gap-4">
        <img src="/icon.png" alt={m.faviconAlt.ko} width="64" height="64" class="size-16 rounded-lg" />
        <img src="/apple-icon.png" alt={m.appleIconAlt.ko} width="56" height="56" class="size-14 rounded-lg" />
        <div class="flex flex-col gap-1">
          <code class="text-code text-text-secondary">favicon.ico 16 · 32 · 48</code>
          <code class="text-code text-text-secondary">icon.png 256</code>
          <code class="text-code text-text-secondary">icon-512.png · apple-icon.png 180</code>
        </div>
      </div>
      <img
        src="/og.png"
        alt={m.ogAlt.ko}
        width="1200"
        height="630"
        loading="lazy"
        class="mt-5 w-full rounded-md border border-border-default"
      />
    </section>
  </div>

  <h2><T m={m.paletteTitle} /></h2>
  <div class="grid gap-3 sm:grid-cols-3">
    {
      mascotPalette.map((swatch) => (
        <div class="flex items-center gap-3 rounded-xl bg-bg-subtle p-3">
          <span
            aria-hidden="true"
            class:list={["size-9 shrink-0 rounded-sm border border-border-default", swatchClass[swatch.token]]}
          />
          <div class="min-w-0">
            <p class="text-code text-text-primary">{swatch.token}</p>
            <p class="text-caption text-text-secondary">{swatch.hex}</p>
            <p class="mt-0.5 text-caption text-text-secondary"><T m={swatch.role} /></p>
          </div>
        </div>
      ))
    }
  </div>

  {
    groups.map((group) => (
      <Fragment>
        <h2><T m={group.title} /></h2>
        <p>
          <T m={group.description} /> ({group.items.length})
        </p>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {group.items.map((mascot) => (
            <figure class="group flex flex-col overflow-hidden rounded-xl bg-bg-subtle">
              <div class="flex aspect-square items-center justify-center p-4 dark:bg-sky-100">
                <img
                  src={mascotImageUrl(mascot.slug)}
                  alt={`${m.mascotAlt.ko} ${mascot.name} ${m.cutSuffix.ko}`}
                  width="384"
                  height="384"
                  loading="lazy"
                  class="size-full object-contain transition-transform duration-200 group-hover:scale-105"
                />
              </div>
              <figcaption class="flex flex-1 flex-col gap-1 px-3 py-2.5">
                <span class="text-code text-text-primary">horon-mascot-{mascot.name}</span>
                <span class="text-caption text-text-secondary">
                  <T m={mascot.use} />
                </span>
                <Button variant="link" href={mascotSourceUrl(mascot.slug)} target="_blank" rel="noreferrer">
                  <T m={m.download} />
                </Button>
              </figcaption>
            </figure>
          ))}
        </div>
      </Fragment>
    ))
  }

  <h2><T m={m.rulesTitle} /></h2>
  <ul>
    {rules.map((rule) => <li><T m={rule} /></li>)}
  </ul>
</DocsLayout>
