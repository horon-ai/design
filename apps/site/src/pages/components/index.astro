---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ComponentGroupSection from "@/components/site/ComponentGroupSection.astro";
import { componentCount, componentGroups } from "@/data/components";
import { demoCount } from "@/lib/demos";
---

<BaseLayout
  title="Components"
  description="HORON 디자인 시스템의 컴포넌트 75개. 입력, 표시, 내비게이션, 오버레이, 레이아웃으로 나눠 정리했습니다."
>
  <div class="py-14">
    <header class="max-w-3xl border-b border-border pb-10">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
        Components
      </p>
      <h1 class="text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.035em] md:text-[3.25rem]">
        {componentCount}개의 컴포넌트
      </h1>
      <p class="mt-5 max-w-2xl text-[15px] leading-7 text-muted-foreground text-pretty">
        <code class="font-mono text-[13px]">@horon/web</code>가 제공하는 컴포넌트 전부입니다. 목록의
        점이 채워진 항목은 이 페이지에서 바로 동작하는 프리뷰를 제공하고, 나머지는 코드 예시와
        Storybook 링크를 제공합니다.
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
        <div>
          <dt class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground">Total</dt>
          <dd class="mt-1 text-[1.5rem] font-semibold tracking-[-0.02em]">{componentCount}</dd>
        </div>
        <div>
          <dt class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground">Live previews</dt>
          <dd class="mt-1 text-[1.5rem] font-semibold tracking-[-0.02em]">{demoCount()}</dd>
        </div>
        <div>
          <dt class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground">Groups</dt>
          <dd class="mt-1 text-[1.5rem] font-semibold tracking-[-0.02em]">{componentGroups.length}</dd>
        </div>
      </dl>
    </header>

    <div class="space-y-14 pt-12">
      {componentGroups.map((group) => <ComponentGroupSection group={group} />)}
    </div>
  </div>
</BaseLayout>
