---
import ComponentGroupSection from "@/components/site/ComponentGroupSection.astro";
import { componentGroups } from "@/data/components";
import { componentsIndexMessages as m } from "@/i18n/messages/components-index";
import DocsLayout from "@/layouts/DocsLayout.astro";
---

<DocsLayout
  title={m.title}
  section="components"
  description={m.description}
  wide
>
  <div class="space-y-16">
    {componentGroups.map((group) => <ComponentGroupSection group={group} />)}
  </div>
</DocsLayout>
