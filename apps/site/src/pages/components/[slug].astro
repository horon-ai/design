---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import Demo from "@/components/site/Demo.astro";
import Footer from "@/components/site/Footer.astro";
import Sidebar from "@/components/site/Sidebar.astro";
import Toc from "@/components/site/Toc.astro";
import { components, componentBySlug, componentGroups } from "@/data/components";
import { resolveDemoName } from "@/lib/demos";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug } }));
}

const { slug } = Astro.params;
const component = componentBySlug(slug);

if (!component) {
  return Astro.redirect("/components");
}

const group = componentGroups.find((entry) => entry.id === component.group);
const demoName = resolveDemoName(component.slug);
const sources = import.meta.glob<string>("../../components/demos/*.tsx", {
  query: "?raw",
  import: "default",
  eager: true,
});
const snippet = (sources[`../../components/demos/${component.slug}.tsx`] ?? "")
  .replace(/^import \{ Backdrop \} from "\.\.\/demo-backdrop";\n\n?/m, "")
  .replace(/<Backdrop[^>]*>\n?/g, "<>\n")
  .replace(/<\/Backdrop>/g, "</>");
const index = components.findIndex((entry) => entry.slug === component.slug);
const previous = index > 0 ? components[index - 1] : undefined;
const next = index >= 0 && index < components.length - 1 ? components[index + 1] : undefined;
const showToc = true;
---

<BaseLayout title={component.title} description={component.description} footer={false}>
  <div class="docs-grid">
    <Sidebar section="components" />

    <article class="docs-main">
      <div class="mx-auto w-full max-w-[56.25rem]">
        <nav
          class="flex flex-wrap items-center gap-2 text-body-sm text-text-secondary"
          aria-label="현재 위치"
        >
          <a href="/components" class="transition-colors hover:text-text-primary">Components</a>
          <span aria-hidden="true">/</span>
          {group && <span>{group.title}</span>}
        </nav>

        <h1 class="doc-title">{component.title}</h1>
        <p class="doc-lead mt-4">{component.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="inline-flex h-9 items-center rounded-lg bg-bg-subtle px-3 text-body-sm">
            @horon-ai/react
          </span>
          {
            group && (
              <span class="inline-flex h-9 items-center rounded-lg bg-bg-subtle px-3 text-body-sm">
                {group.title}
              </span>
            )
          }
        </div>

        {/* Toc.astro collects its links from `article .prose-docs h2, h3`. */}
        <div class="prose-docs">
          <h2 class="mt-14 mb-6 text-title-md font-medium">Preview</h2>
          {
            demoName ? (
              <Demo name={demoName} overlay={component.overlay} />
            ) : (
              <div class="demo-stage">
                <p class="max-w-md text-center text-body-sm leading-6 text-text-secondary">
                  이 컴포넌트는 라이브 프리뷰를 아직 준비하지 않았습니다. Usage의 코드 예시를
                  참고하세요.
                </p>
              </div>
            )
          }

          <h2 class="mt-16 mb-6 text-title-md font-medium">Usage</h2>
          <CodeBlock code={snippet} title="tsx" />
        </div>

        <nav class="mt-16 grid gap-6 border-t border-border-default pt-8 sm:grid-cols-2">
          {
            previous ? (
              <a href={`/components/${previous.slug}`} class="card-link">
                <span class="text-caption text-text-secondary">← 이전</span>
                <span class="text-body-md font-medium">{previous.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={`/components/${next.slug}`} class="card-link text-right">
                <span class="text-caption text-text-secondary">다음 →</span>
                <span class="text-body-md font-medium">{next.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>

      <Footer />
    </article>

    {showToc && <Toc />}
  </div>
</BaseLayout>
