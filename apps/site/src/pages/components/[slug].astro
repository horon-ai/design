---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import Demo from "@/components/site/Demo.astro";
import Footer from "@/components/site/Footer.astro";
import Sidebar from "@/components/site/Sidebar.astro";
import Toc from "@/components/site/Toc.astro";
import { components, componentBySlug, componentGroups } from "@/data/components";
import { usageSnippets } from "@/data/usage";
import { resolveDemoName } from "@/lib/demos";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug } }));
}

const { slug } = Astro.params;
const component = componentBySlug(slug);

if (!component) {
  return Astro.redirect("/components");
}

const group = componentGroups.find((entry) => entry.id === component.group);
const demoName = resolveDemoName(component.slug, component.demo);
const snippet =
  usageSnippets[component.slug] ??
  `import { ${component.title.replace(/\s/g, "")} } from "@horon-ai/react";`;
const storybookHref = `https://storybook.horon.ai/?path=/story/web-${component.slug}--default`;
const index = components.findIndex((entry) => entry.slug === component.slug);
const previous = index > 0 ? components[index - 1] : undefined;
const next = index >= 0 && index < components.length - 1 ? components[index + 1] : undefined;
const showToc = true;
---

<BaseLayout title={component.title} description={component.description} footer={false}>
  <div class="docs-grid">
    <Sidebar section="components" />

    <article class="docs-main">
      <div class="mx-auto w-full max-w-[56.25rem]">
        <nav
          class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground"
          aria-label="현재 위치"
        >
          <a href="/components" class="transition-colors hover:text-foreground">Components</a>
          <span aria-hidden="true">/</span>
          {group && <span>{group.title}</span>}
        </nav>

        <h1 class="doc-title">{component.title}</h1>
        <p class="doc-lead mt-4">{component.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="inline-flex h-9 items-center rounded-lg bg-muted px-3 text-sm">
            @horon-ai/react
          </span>
          {
            group && (
              <span class="inline-flex h-9 items-center rounded-lg bg-muted px-3 text-sm">
                {group.title}
              </span>
            )
          }
          <a
            href={storybookHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex h-9 items-center rounded-lg bg-muted px-3 text-sm transition-colors hover:text-foreground"
          >
            Storybook ↗
          </a>
        </div>

        {/* Toc.astro collects its links from `article .prose-docs h2, h3`. */}
        <div class="prose-docs">
          <h2 class="mt-14 mb-6 text-2xl font-medium">Preview</h2>
          {
            demoName ? (
              <Demo name={demoName} overlay={component.overlay} />
            ) : (
              <div class="demo-stage">
                <p class="max-w-md text-center text-sm leading-6 text-muted-foreground">
                  이 컴포넌트는 라이브 프리뷰 대신 코드 예시와 Storybook 링크로 안내합니다. 전체
                  상태와 변형은 Storybook에서 확인할 수 있습니다.
                </p>
              </div>
            )
          }

          <h2 class="mt-16 mb-6 text-2xl font-medium">Usage</h2>
          <CodeBlock code={snippet} title="tsx" />
        </div>

        <nav class="mt-16 grid gap-6 border-t border-border pt-8 sm:grid-cols-2">
          {
            previous ? (
              <a href={`/components/${previous.slug}`} class="card-link">
                <span class="text-xs text-muted-foreground">← 이전</span>
                <span class="text-base font-medium">{previous.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={`/components/${next.slug}`} class="card-link text-right">
                <span class="text-xs text-muted-foreground">다음 →</span>
                <span class="text-base font-medium">{next.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>

      <Footer />
    </article>

    {showToc && <Toc />}
  </div>
</BaseLayout>
