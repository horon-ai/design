---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import Demo from "@/components/site/Demo.astro";
import Sidebar from "@/components/site/Sidebar.astro";
import { components, componentBySlug, componentGroups } from "@/data/components";
import { usageSnippets } from "@/data/usage";
import { resolveDemoName } from "@/lib/demos";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug } }));
}

const { slug } = Astro.params;
const component = componentBySlug(slug);

if (!component) {
  return Astro.redirect("/components");
}

const group = componentGroups.find((entry) => entry.id === component.group);
const demoName = resolveDemoName(component.slug, component.demo);
const snippet = usageSnippets[component.slug] ?? `import { ${component.title.replace(/\s/g, "")} } from "@horon-ai/react";`;
const storybookHref = `https://storybook.horon.ai/?path=/story/web-${component.slug}--default`;
const index = components.findIndex((entry) => entry.slug === component.slug);
const previous = index > 0 ? components[index - 1] : undefined;
const next = index >= 0 && index < components.length - 1 ? components[index + 1] : undefined;
---

<BaseLayout title={component.title} description={component.description}>
  <div class="flex flex-col gap-10 pb-24 pt-10 lg:flex-row lg:gap-14">
    <Sidebar section="components" />
    <div class="min-w-0 flex-1">
      <nav class="mb-6 flex items-center gap-2 text-[12.5px] text-muted-foreground" aria-label="위치">
        <a href="/components" class="transition-colors hover:text-foreground">Components</a>
        <span aria-hidden="true">/</span>
        <span>{group?.title}</span>
      </nav>

      <header class="max-w-3xl">
        <h1 class="text-[2.25rem] font-semibold leading-[1.08] tracking-[-0.03em] md:text-[2.75rem]">
          {component.title}
        </h1>
        <p class="mt-4 max-w-2xl text-[0.9375rem] leading-7 text-muted-foreground text-pretty">
          {component.description}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-border px-2.5 py-1 font-mono text-[11px] text-muted-foreground">
            @horon-ai/react
          </span>
          <span class="rounded-full border border-border px-2.5 py-1 font-mono text-[11px] text-muted-foreground">
            {group?.title}
          </span>
          <a
            href={storybookHref}
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-border px-2.5 py-1 font-mono text-[11px] text-muted-foreground transition-colors hover:border-foreground/25 hover:text-foreground"
          >
            Storybook ↗
          </a>
        </div>
      </header>

      <section class="mt-10">
        <h2 class="mb-3 text-[13px] font-medium uppercase tracking-[0.12em] text-muted-foreground">Preview</h2>
        {demoName ? (
          <Demo name={demoName} overlay={component.overlay} />
        ) : (
          <div class="demo-surface justify-center py-14 text-center">
            <p class="max-w-md text-[13px] leading-6 text-muted-foreground">
              이 컴포넌트는 라이브 프리뷰 대신 코드 예시와 Storybook 링크로 안내합니다.
              전체 상태와 변형은 Storybook에서 확인할 수 있습니다.
            </p>
          </div>
        )}
      </section>

      <section class="mt-10">
        <h2 class="mb-3 text-[13px] font-medium uppercase tracking-[0.12em] text-muted-foreground">Usage</h2>
        <CodeBlock code={snippet} title="tsx" />
      </section>

      <nav class="mt-14 flex items-center justify-between gap-4 border-t border-border pt-6 text-[13px]">
        {
          previous ? (
            <a href={`/components/${previous.slug}`} class="group flex flex-col gap-0.5">
              <span class="text-[11px] text-muted-foreground">이전</span>
              <span class="transition-colors group-hover:text-muted-foreground">{previous.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={`/components/${next.slug}`} class="group flex flex-col items-end gap-0.5">
              <span class="text-[11px] text-muted-foreground">다음</span>
              <span class="transition-colors group-hover:text-muted-foreground">{next.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </div>
</BaseLayout>
