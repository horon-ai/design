---
import { Badge, EmptyState } from "@horon-ai/react";
import { createElement, Fragment, type ReactNode } from "react";

import CodeBlock from "@/components/site/CodeBlock.astro";
import { ComponentCard } from "@/components/site/ComponentCard";
import Demo from "@/components/site/Demo.astro";
import { PreviewTabs } from "@/components/site/PreviewTabs";
import T from "@/components/i18n/T.astro";
import { components, componentBySlug, componentGroups } from "@/data/components";
import type { Localized } from "@/i18n";
import { componentPageMessages as m } from "@/i18n/messages/components-page";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { resolveDemoName } from "@/lib/demos";
import { siteHref } from "@/lib/urls";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug } }));
}

const { slug } = Astro.params;
const component = componentBySlug(slug);

if (!component) {
  return Astro.redirect("/components");
}

const group = componentGroups.find((entry) => entry.id === component.group);
const demoName = resolveDemoName(component.slug);
const sources = import.meta.glob<string>("../../components/demos/*.tsx", {
  query: "?raw",
  import: "default",
  eager: true,
});
const snippet = (sources[`../../components/demos/${component.slug}.tsx`] ?? "")
  .replace(/^import \{ Backdrop \} from "\.\.\/demo-backdrop";\n\n?/m, "")
  .replace(/<Backdrop[^>]*>\n?/g, "<>\n")
  .replace(/<\/Backdrop>/g, "</>");
const index = components.findIndex((entry) => entry.slug === component.slug);
const previous = index > 0 ? components[index - 1] : undefined;
const next = index >= 0 && index < components.length - 1 ? components[index + 1] : undefined;

/**
 * Library components take React nodes for `title` and `description`, which
 * Astro cannot pass as props. Building the same two-span markup `T.astro`
 * renders keeps the static locale switch without a client island.
 */
function localized(entry: Localized): ReactNode {
  return createElement(
    Fragment,
    null,
    createElement("span", { "data-locale-text": "ko", lang: "ko" }, entry.ko),
    createElement("span", { "data-locale-text": "en", lang: "en" }, entry.en),
  );
}

const breadcrumb = [
  { label: m.breadcrumbComponents, href: "/components" },
  ...(group ? [{ label: group.title, href: `/components#${component.group}` }] : []),
  { label: component.title, href: siteHref(`/components/${component.slug}`) },
];
---

<DocsLayout
  title={component.title}
  description={component.description}
  section="components"
  breadcrumb={breadcrumb}
  toc={false}
>
  <div class="flex flex-wrap items-center gap-2">
    <Badge tone="neutral">@horon-ai/react</Badge>
    {group && <Badge tone="brand"><T m={group.title} /></Badge>}
  </div>

  <PreviewTabs client:load previewLabel={m.previewTab} codeLabel={m.codeTab}>
    <div slot="preview">
      {
        demoName ? (
          <Demo name={demoName} overlay={component.overlay} />
        ) : (
          <EmptyState
            className="mx-auto"
            title={localized(m.previewMissingTitle)}
            description={localized(m.previewMissingBody)}
          />
        )
      }
    </div>
    <div slot="code">
      <CodeBlock code={snippet} title="tsx" />
    </div>
  </PreviewTabs>

  <nav
    class="mt-16 grid gap-6 border-t border-border-default pt-8 sm:grid-cols-2"
    aria-label={m.paging.ko}
  >
    {
      previous ? (
        <ComponentCard
          href={siteHref(`/components/${previous.slug}`)}
          title={previous.title}
          description={m.previous}
        />
      ) : (
        <span />
      )
    }
    {
      next ? (
        <ComponentCard
          href={siteHref(`/components/${next.slug}`)}
          title={next.title}
          description={m.next}
        />
      ) : (
        <span />
      )
    }
  </nav>
</DocsLayout>
