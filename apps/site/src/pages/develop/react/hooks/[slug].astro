---
import T from "@/components/i18n/T.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import { reactBreadcrumb } from "@/data/nav";
import { reactHooks, type ReactHookDoc } from "@/data/react-hooks";
import { hookPageMessages as m } from "@/i18n/messages/develop-hooks";
import DocsLayout from "@/layouts/DocsLayout.astro";

export function getStaticPaths() {
  return reactHooks.map((hook) => ({ params: { slug: hook.slug }, props: { hook } }));
}

interface Props {
  hook: ReactHookDoc;
}

const { hook } = Astro.props;
const title = { ko: hook.name, en: hook.name };
---

<DocsLayout
  title={title}
  description={hook.summary}
  section="develop"
  breadcrumb={reactBreadcrumb(title, `/develop/react/hooks/${hook.slug}`)}
>
  <h2><T m={m.usage} /></h2>
  <CodeBlock code={hook.example} lang="tsx" title={hook.exampleFile} />

  <h2><T m={m.signature} /></h2>
  <CodeBlock code={hook.signature} lang="ts" title={`${hook.slug}.ts`} />

  <h2><T m={m.parameters} /></h2>
  {
    hook.params.length === 0 ? (
      <p><T m={m.noParams} /></p>
    ) : (
      <div class="not-prose overflow-x-auto">
        <table class="w-full border-collapse text-left text-body-sm">
          <thead>
            <tr class="border-b border-border-default text-text-primary">
              <th class="py-2 pr-4 font-medium whitespace-nowrap"><T m={m.columnName} /></th>
              <th class="py-2 pr-4 font-medium"><T m={m.columnType} /></th>
              <th class="py-2 pr-4 font-medium whitespace-nowrap"><T m={m.columnDefault} /></th>
              <th class="py-2 font-medium"><T m={m.columnDescription} /></th>
            </tr>
          </thead>
          <tbody>
            {hook.params.map((param) => (
              <tr class="border-b border-border-default align-top last:border-b-0">
                <td class="py-3 pr-4 whitespace-nowrap text-text-primary"><code>{param.name}</code></td>
                <td class="py-3 pr-4"><code>{param.type}</code></td>
                <td class="py-3 pr-4"><code>{param.defaultValue ?? "-"}</code></td>
                <td class="py-3"><T m={param.description} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2><T m={m.returns} /></h2>
  <p><T m={hook.returns} /></p>

  <h2><T m={m.notes} /></h2>
  <ul>
    {hook.notes.map((note) => (
      <li><T m={note} /></li>
    ))}
  </ul>
</DocsLayout>
