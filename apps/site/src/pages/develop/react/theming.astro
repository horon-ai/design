---
import T from "@/components/i18n/T.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import { reactBreadcrumb } from "@/data/nav";
import { reactStartSnippets as snippets, reactThemingMessages as m } from "@/i18n/messages/develop-react-start";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { siteHref } from "@/lib/urls";
---

<DocsLayout
  title={m.title}
  description={m.description}
  section="develop"
  breadcrumb={reactBreadcrumb(m.title, "/develop/react/theming")}
>
  <h2><T m={m.darkHeading} /></h2>
  <p><T m={m.darkBody} /></p>
  <CodeBlock code={snippets.darkHtml} lang="html" title="index.html" />
  <p><T m={m.darkLinkPrefix} /><a href={siteHref("/develop/react/hooks/use-color-scheme")}>useColorScheme</a><T m={m.darkLinkSuffix} /></p>
  <CodeBlock code={snippets.darkToggle} lang="tsx" title="theme-toggle.tsx" />

  <h2><T m={m.platformHeading} /></h2>
  <p><T m={m.platformBody} /></p>
  <CodeBlock code={snippets.platformHtml} lang="html" title="index.html" />
  <p><T m={m.platformRule} /></p>

  <h2><T m={m.jsHeading} /></h2>
  <p><T m={m.jsBody} /></p>
  <CodeBlock code={snippets.tokensJs} lang="ts" title="tokens.ts" />

  <h2><T m={m.generatedHeading} /></h2>
  <p><T m={m.generatedBody} /></p>
  <CodeBlock code={snippets.tokensBuild} lang="bash" title="terminal" />
</DocsLayout>
