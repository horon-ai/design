---
import T from "@/components/i18n/T.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import { reactBreadcrumb } from "@/data/nav";
import { reactStartSnippets as snippets, reactStylingMessages as m } from "@/i18n/messages/develop-react-start";
import DocsLayout from "@/layouts/DocsLayout.astro";
---

<DocsLayout
  title={m.title}
  description={m.description}
  section="develop"
  breadcrumb={reactBreadcrumb(m.title, "/develop/react/styling")}
>
  <h2><T m={m.importHeading} /></h2>
  <p><T m={m.importBody} /></p>
  <CodeBlock code={snippets.styles} lang="css" title="styles.css" />

  <h2><T m={m.bringsHeading} /></h2>
  <ul>
    <li><T m={m.bringsTailwind} /></li>
    <li><T m={m.bringsFonts} /></li>
    <li><T m={m.bringsGlass} /></li>
    <li><T m={m.bringsBase} /></li>
    <li><T m={m.bringsMotion} /></li>
  </ul>

  <h2><T m={m.tokenHeading} /></h2>
  <p><T m={m.tokenBody} /></p>
  <CodeBlock code={snippets.tokenClasses} lang="tsx" title="note.tsx" />

  <h2><T m={m.overrideHeading} /></h2>
  <p><T m={m.overrideBody} /></p>
  <CodeBlock code={snippets.override} lang="tsx" title="actions.tsx" />
  <p><T m={m.overrideNote} /></p>
</DocsLayout>
