---
import CatalogTile from "@/components/site/CatalogTile.astro";
import { developMessages as m } from "@/i18n/messages/develop";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { siteHref } from "@/lib/urls";

/* Each tile shows the one line a developer writes first on that platform, set
 * as a static code chip on the 400×225 thumbnail canvas. */
const items = [
  {
    href: "/develop/react",
    title: m.reactTitle,
    file: "example.tsx",
    lines: ['import { Button }', 'from "@horon-ai/react";'],
  },
  {
    href: "/develop/lynx",
    title: m.lynxTitle,
    file: "App.tsx",
    lines: ['import { Button }', 'from "@horon-ai/lynx";'],
  },
];
---

<DocsLayout title={m.title} section="develop" description={m.description} wide>
  <ul class="catalog-grid not-prose">
    {
      items.map((item) => (
        <CatalogTile href={siteHref(item.href)} title={item.title}>
          <div class="w-72 overflow-hidden rounded-xl border border-border-default bg-bg-surface">
            <p class="border-b border-border-default px-4 py-2 font-mono text-caption text-text-secondary">{item.file}</p>
            <div class="flex flex-col gap-1 px-4 py-4 font-mono text-body-sm text-text-primary">
              {item.lines.map((line) => (
                <span>{line}</span>
              ))}
            </div>
          </div>
        </CatalogTile>
      ))
    }
  </ul>
</DocsLayout>
