---
import T from "@/components/i18n/T.astro";
import LinkTile from "@/components/site/LinkTile.astro";
import { componentCount } from "@/data/components";
import { externalLinks } from "@/data/nav";
import type { Localized } from "@/i18n";
import { fill } from "@/i18n/messages/fill";
import { getStartedMessages as m } from "@/i18n/messages/get-started";
import { siteHref } from "@/lib/urls";
import DocsLayout from "@/layouts/DocsLayout.astro";

const github = externalLinks.find((link) => link.href.includes("github.com"))?.href ?? "https://github.com/horon-ai/design";

const sections: { title: Localized; links: { href: string; title: Localized; description: Localized }[] }[] = [
  {
    title: m.systemTitle,
    links: [
      { href: "/foundations", title: m.foundationsTitle, description: m.foundationsBody },
      { href: "/components", title: m.componentsTitle, description: fill(m.componentsBody, { count: componentCount }) },
      { href: "/mascot", title: m.mascotTitle, description: m.mascotBody },
    ],
  },
  {
    title: m.developTitle,
    links: [
      { href: "/develop/react", title: m.reactTitle, description: m.reactBody },
      { href: "/develop/flutter", title: m.flutterTitle, description: m.flutterBody },
      { href: "/llms.txt", title: m.aiTitle, description: m.aiBody },
    ],
  },
  {
    title: m.helpTitle,
    links: [
      { href: github, title: m.githubTitle, description: m.githubBody },
      { href: "/updates", title: m.updatesTitle, description: m.updatesBody },
    ],
  },
];
---

<DocsLayout title={m.title} description={m.description} section="get-started">
  <h2><T m={m.whatTitle} /></h2>
  <p><T m={m.whatBody} /></p>

  {
    sections.map((section) => (
      <>
        <h2>
          <T m={section.title} />
        </h2>
        <div class="not-prose grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {section.links.map((link) => (
            <LinkTile
              href={link.href.startsWith("http") ? link.href : siteHref(link.href)}
              title={link.title}
              description={link.description}
            />
          ))}
        </div>
      </>
    ))
  }
</DocsLayout>
