---
import { Badge, Button, Card } from "@horon-ai/react";
import { createElement, Fragment, type ReactElement, type ReactNode } from "react";

import T from "@/components/i18n/T.astro";
import { componentCount, components, componentGroups, componentsInGroup } from "@/data/components";
import { mascotImageUrl, mascotSpec } from "@/data/mascots";
import type { Localized } from "@/i18n";
import { homeMessages as m } from "@/i18n/messages/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { demoCount } from "@/lib/demos";

const featured = ["button", "card", "input", "dialog", "tabs", "select", "sidebar", "tool-call"];
const showcase = featured
  .map((slug) => components.find((component) => component.slug === slug))
  .filter((component): component is NonNullable<typeof component> => Boolean(component));

const stats: { label: Localized; value: Localized | number }[] = [
  { label: m.statComponents, value: componentCount },
  { label: m.statPreviews, value: demoCount() },
  { label: m.statCuts, value: mascotSpec.count },
  { label: m.statPlatforms, value: m.platformValue },
];

const principles = [
  { title: m.principleInkTitle, body: m.principleInkBody },
  { title: m.principleGlassTitle, body: m.principleGlassBody },
  { title: m.principleSourceTitle, body: m.principleSourceBody },
];

const mascotCuts = ["main", "cheer", "think", "wave", "success", "lost"];

const entryCards = [
  { title: m.foundationsTitle, body: m.foundationsBody, href: "/foundations" },
  { title: m.getStartedTitle, body: m.getStartedBody, href: "/get-started" },
  { title: m.componentsTitle, body: m.componentsBody, href: "/components" },
];

/**
 * Library components take React nodes for `title` and `description`, which
 * Astro cannot pass as props. Building the same two-span markup `T.astro`
 * renders keeps the static locale switch without a client island.
 */
function localized(entry: Localized): ReactNode {
  return createElement(
    Fragment,
    null,
    createElement("span", { "data-locale-text": "ko", lang: "ko" }, entry.ko),
    createElement("span", { "data-locale-text": "en", lang: "en" }, entry.en),
  );
}

/** Anchor for `Card`'s `render` prop; library Buttons take `href` directly. */
function linkTo(href: string): ReactElement {
  return createElement("a", { href });
}

---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="mx-auto w-full max-w-275 px-4 py-20 md:px-6 md:py-28">
      <p class="text-body-sm text-text-secondary"><T m={m.eyebrow} /></p>
      <h1 class="mt-6 max-w-4xl text-display-lg text-balance text-text-primary">
        <T m={m.titleLine1} /><br /><T m={m.titleLine2} />
      </h1>
      <p class="mt-7 max-w-xl text-body-lg text-text-secondary text-pretty"><T m={m.body} /></p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button variant="primary" href="/get-started">
          <T m={m.start} />
        </Button>
        <Button variant="glass" href="/components">
          <T m={m.browseComponents} />
        </Button>
      </div>

      <img
        src={mascotImageUrl("main")}
        alt={m.mascotAlt.ko}
        width="320"
        height="320"
        class="pointer-events-none absolute right-6 bottom-6 hidden size-64 object-contain lg:block xl:right-16 xl:size-80"
      />

      <dl
        class="mt-16 grid max-w-3xl grid-cols-2 gap-x-8 gap-y-6 border-t border-border-default pt-8 sm:grid-cols-4"
      >
        {
          stats.map((stat) => (
            <div>
              <dt class="text-caption text-text-secondary">
                <T m={stat.label} />
              </dt>
              <dd class="mt-1.5 text-title-md text-text-primary">
                {typeof stat.value === "number" ? stat.value : <T m={stat.value} />}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="border-t border-border-default">
    <div class="mx-auto w-full max-w-275 px-4 py-20 md:px-6">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-body-sm text-text-secondary"><T m={m.principlesEyebrow} /></p>
          <h2 class="mt-4 text-title-md text-text-primary"><T m={m.principlesTitle} /></h2>
          <p class="mt-4 max-w-md text-body-sm text-text-secondary"><T m={m.principlesBody} /></p>
        </div>
        <ol class="divide-y divide-border-default border-y border-border-default">
          {
            principles.map((principle, index) => (
              <li class="flex gap-5 py-6">
                <Badge tone="neutral">{String(index + 1).padStart(2, "0")}</Badge>
                <div>
                  <p class="text-label-lg text-text-primary">
                    <T m={principle.title} />
                  </p>
                  <p class="mt-1.5 text-body-sm text-text-secondary">
                    <T m={principle.body} />
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-border-default">
    <div class="mx-auto w-full max-w-275 px-4 py-20 md:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-body-sm text-text-secondary"><T m={m.componentsEyebrow} /></p>
          <h2 class="mt-4 text-title-md text-text-primary">
            {componentCount}<T m={m.componentsUnit} />, {componentGroups.length}<T m={m.groupsUnit} />
          </h2>
        </div>
        <Button variant="link" href="/components">
          <T m={m.allComponents} />
        </Button>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          componentGroups.map((group) => (
            <Card
              interactive
              render={linkTo("/components")}
              title={localized(group.title)}
              description={localized(group.description)}
            >
              <div class="flex w-full items-center justify-between gap-3">
                <Badge tone="neutral">
                  {componentsInGroup(group.id).length}
                  <T m={m.groupCountUnit} />
                </Badge>
                <span class="text-caption text-text-secondary">
                  <T m={m.openGroup} />
                </span>
              </div>
            </Card>
          ))
        }
      </div>

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
        {
          showcase.map((component) => (
            <li>
              <Button
                variant="link"
                href={`/components/${component.slug}`}
              >
                <T m={component.title} />
              </Button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border-default">
    <div class="mx-auto w-full max-w-275 px-4 py-20 md:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-body-sm text-text-secondary"><T m={m.mascotEyebrow} /></p>
          <h2 class="mt-4 text-title-md text-text-primary">
            <T m={m.mascotTitleLead} />{mascotSpec.count}<T m={m.mascotTitleTail} />
          </h2>
          <p class="mt-4 max-w-md text-body-sm text-text-secondary"><T m={m.mascotBody} /></p>
          <div class="mt-6">
            <Button variant="glass" href="/mascot">
              <T m={m.viewMascot} />
            </Button>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          {
            mascotCuts.map((slug) => (
              <div class="flex aspect-square items-center justify-center rounded-xl bg-bg-subtle p-2">
                <img
                  src={mascotImageUrl(slug)}
                  alt={`${m.mascotAlt.ko} ${slug} ${m.cutSuffix.ko}`}
                  width="160"
                  height="160"
                  loading="lazy"
                  class="size-full object-contain"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border-default">
    <div class="mx-auto w-full max-w-275 px-4 py-20 md:px-6">
      <div class="grid gap-4 md:grid-cols-3">
        {
          entryCards.map((card) => (
            <Card
              interactive
              render={linkTo(card.href)}
              title={localized(card.title)}
              description={localized(card.body)}
            >
              <span class="text-caption text-text-secondary">
                <T m={m.openCard} />
              </span>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
