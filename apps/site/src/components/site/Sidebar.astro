---
import { foundationsNav, isActive, primaryNav } from "@/data/nav";
import { componentGroups, componentsInGroup } from "@/data/components";

interface Props {
  section: string;
}

interface NavBlock {
  label?: string;
  entries: { label: string; href: string; current: boolean }[];
}

const { section } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isFoundations = section === "foundations";
const isComponents = section === "components";

const blocks: NavBlock[] = isFoundations
  ? [
      {
        entries: foundationsNav.map((item) => ({
          label: item.label,
          href: item.href,
          current:
            item.href === "/foundations" ? path === "/foundations" : isActive(path, item.href),
        })),
      },
    ]
  : isComponents
    ? [
        {
          entries: [{ label: "Overview", href: "/components", current: path === "/components" }],
        },
        ...componentGroups.map((group) => ({
          label: group.title,
          entries: componentsInGroup(group.id).map((component) => ({
            label: component.title,
            href: `/components/${component.slug}`,
            current: path === `/components/${component.slug}`,
          })),
        })),
      ]
    : [
        {
          label: "Docs",
          entries: primaryNav.map((item) => ({
            label: item.label,
            href: item.href,
            current: isActive(path, item.href),
          })),
        },
      ];
---

<aside class="docs-sidebar">
  <details class="group lg:hidden">
    <summary
      class="flex cursor-pointer list-none items-center justify-between rounded-lg px-2 py-2 text-sm text-muted-foreground [&::-webkit-details-marker]:hidden"
    >
      목차
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        class="transition-transform group-open:rotate-180"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <nav class="pt-2" aria-label="섹션 목차">
      {
        blocks.map((block) => (
          <>
            {block.label && <p class="nav-group-label">{block.label}</p>}
            <ul>
              {block.entries.map((entry) => (
                <li>
                  <a
                    href={entry.href}
                    aria-current={entry.current ? "page" : undefined}
                    class="nav-item"
                  >
                    {entry.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </nav>
  </details>

  <nav class="hidden lg:block" aria-label="섹션 목차">
    {
      blocks.map((block) => (
        <>
          {block.label && <p class="nav-group-label">{block.label}</p>}
          <ul>
            {block.entries.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  aria-current={entry.current ? "page" : undefined}
                  class="nav-item"
                >
                  {entry.label}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </nav>
</aside>
