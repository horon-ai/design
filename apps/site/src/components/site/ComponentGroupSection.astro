---
import T from "@/components/i18n/T.astro";
import CatalogTile from "@/components/site/CatalogTile.astro";
import { componentGroups, componentsInGroup } from "@/data/components";
import { getThumbnail } from "@/lib/thumbnails";
import { siteHref } from "@/lib/urls";

interface Props {
  group: (typeof componentGroups)[number];
}

const { group } = Astro.props;
const items = componentsInGroup(group.id).map((component) => ({
  component,
  Thumbnail: getThumbnail(component.slug),
}));
---

<section class="not-prose">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-title-md text-text-primary"><T m={group.title} /></h2>
    <span class="text-caption text-text-secondary">{items.length}</span>
  </div>
  <p class="mt-1.5 text-body-sm text-text-secondary"><T m={group.description} /></p>
  <ul class="catalog-grid mt-8">
    {
      items.map(({ component, Thumbnail }) => (
        <CatalogTile href={siteHref(`/components/${component.slug}`)} title={component.title}>
          {Thumbnail && <Thumbnail />}
        </CatalogTile>
      ))
    }
  </ul>
</section>
