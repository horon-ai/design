---
import Demo from "@/components/site/Demo.astro";
import { componentGroups, componentsInGroup } from "@/data/components";
import { resolveDemoName } from "@/lib/demos";

interface Props {
  group: (typeof componentGroups)[number];
}

const { group } = Astro.props;
const items = componentsInGroup(group.id);
---

<section class="not-prose">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-2xl font-medium">{group.title}</h2>
    <span class="text-xs text-muted-foreground">{items.length}</span>
  </div>
  <p class="mt-1.5 text-sm text-muted-foreground">{group.description}</p>
  <div class="mt-8 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
    {
      items.map((component) => {
        const demoName = component.overlay
          ? undefined
          : resolveDemoName(component.slug, component.demo);
        return (
          <a href={`/components/${component.slug}`} class="group flex min-w-0 flex-col gap-5">
            <div class="demo-tile min-w-0">
              {demoName ? (
                <div class="pointer-events-none w-full min-w-0 scale-[0.7] origin-center">
                  <Demo name={demoName} />
                </div>
              ) : (
                <span class="text-[13px] text-muted-foreground">{component.title}</span>
              )}
            </div>
            <span class="text-xl font-medium">{component.title}</span>
            <span class="line-clamp-2 text-sm leading-6 text-muted-foreground">
              {component.description}
            </span>
          </a>
        );
      })
    }
  </div>
</section>
