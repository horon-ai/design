---
/**
 * The `accessibility` section: the WAI-ARIA pattern the component follows, the
 * notes a caller has to preserve, and the keyboard table.
 */
import T from "@/components/i18n/T.astro";
import { componentPageMessages as m } from "@/i18n/messages/components-page";
import type { ComponentDoc } from "@/lib/component-docs";

interface Props {
  doc: ComponentDoc;
}

const { doc } = Astro.props;
const { pattern, notes, keyboard } = doc.accessibility;
---

<section>
  <h2 id="accessibility"><T m={m.sectionAccessibility} /></h2>
  <div class="flex flex-col gap-4">
    {
      pattern && (
        <p class="text-body-sm">
          <T m={m.patternPrefix} />
          <a href={pattern.href} target="_blank" rel="noreferrer">
            {pattern.label}
          </a>
        </p>
      )
    }
    {
      notes.map((note) => (
        <p>
          <T m={note} />
        </p>
      ))
    }
    {
      keyboard.length > 0 && (
        <div class="min-w-0 overflow-x-auto">
          <table class="w-full min-w-120 border-collapse text-left text-body-sm">
            <thead>
              <tr class="border-b border-border-strong">
                <th scope="col" class="py-2 pr-4 font-medium text-text-secondary">
                  <T m={m.keyHeader} />
                </th>
                <th scope="col" class="py-2 font-medium text-text-secondary">
                  <T m={m.actionHeader} />
                </th>
              </tr>
            </thead>
            <tbody>
              {keyboard.map((row) => (
                <tr class="border-b border-border-default align-top">
                  <td class="py-2 pr-4">
                    <span class="inline-flex flex-wrap items-center gap-1">
                      {row.keys.map((key, index) => (
                        <>
                          {index > 0 && <span class="text-text-secondary">/</span>}
                          <kbd class="rounded-xs border border-border-default bg-bg-subtle px-1.5 py-0.5 font-mono text-caption text-text-primary">
                            {key}
                          </kbd>
                        </>
                      ))}
                    </span>
                  </td>
                  <td class="py-2">
                    <T m={row.action} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</section>
