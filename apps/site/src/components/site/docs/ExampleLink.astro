---
/**
 * A pointer from a property or guideline to the live example that shows it.
 *
 * Each example renders live exactly once, in the Examples section: a second
 * copy would be a second island with the same hardcoded element ids (and the
 * same `aria-describedby` targets), so later references link to it instead.
 */
import T from "@/components/i18n/T.astro";
import { componentPageMessages as m } from "@/i18n/messages/components-page";
import type { ComponentDoc } from "@/lib/component-docs";

interface Props {
  doc: ComponentDoc;
  id: string;
}

const { doc, id } = Astro.props;
const example = doc.examples.find((entry) => entry.id === id);
---

{
  example && (
    <a
      href={`#example-${id}`}
      class="not-prose inline-flex w-fit items-center gap-1.5 text-label-md text-text-brand underline-offset-4 hover:underline"
    >
      <T m={m.seeExample} />
      <span aria-hidden="true">·</span>
      <T m={example.title} />
      <span aria-hidden="true">↓</span>
    </a>
  )
}
