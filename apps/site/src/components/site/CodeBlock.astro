---
import { CodePanel } from "@horon-ai/react";

import { CopyButton } from "@/components/site/CopyButton";
import type { Localized } from "@/i18n";
import { type CodeTone, highlight } from "@/lib/highlight";

interface Props {
  /** One sample for both locales, or one per locale when the comments differ. */
  code: string | Localized;
  lang?: string;
  title?: string;
}

const { code, lang = "tsx", title } = Astro.props;
const label = title ?? lang;

// Token utilities only: the syntax colors and secondary text switch with the theme on their own.
const toneClass: Record<CodeTone, string | undefined> = {
  plain: undefined,
  key: "text-syntax-key",
  value: "text-syntax-number",
  muted: "text-syntax-punctuation",
  comment: "text-text-secondary",
};

const samples =
  typeof code === "string"
    ? [{ locale: undefined, lines: await highlight(code.trim(), lang) }]
    : await Promise.all(
        (["ko", "en"] as const).map(async (locale) => ({ locale, lines: await highlight(code[locale].trim(), lang) })),
      );
---

<figure class="not-prose flex flex-col gap-2">
  <figcaption class="flex items-center justify-between gap-4">
    <span class="font-mono text-caption text-text-secondary">{label}</span>
    <CopyButton client:visible code={code} />
  </figcaption>
  {
    samples.map(({ locale, lines }) => (
      <div data-locale-text={locale} lang={locale}>
        <CodePanel>
          {lines.map((line, index) => (
            <Fragment>
              {index > 0 && "\n"}
              {line.map((token) => (toneClass[token.tone] ? <span class={toneClass[token.tone]}>{token.content}</span> : token.content))}
            </Fragment>
          ))}
        </CodePanel>
      </div>
    ))
  }
</figure>
