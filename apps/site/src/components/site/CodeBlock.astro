---
import { CodePanel } from "@horon-ai/react";

import { CopyButton } from "@/components/site/CopyButton";
import type { Localized } from "@/i18n";
import { type CodeRole, highlight } from "@/lib/highlight";

interface Props {
  /** One sample for both locales, or one per locale when the comments differ. */
  code: string | Localized;
  lang?: string;
  title?: string;
}

const { code, lang = "tsx", title } = Astro.props;
const label = title ?? lang;

// Colors come from the site code palette in site.css: one class per role, so
// light and dark both switch with the theme instead of one flat color.
const roleClass: Record<CodeRole, string | undefined> = {
  plain: undefined,
  keyword: "site-code-keyword",
  operator: "site-code-operator",
  function: "site-code-function",
  tag: "site-code-tag",
  type: "site-code-type",
  attribute: "site-code-attribute",
  property: "site-code-property",
  string: "site-code-string",
  number: "site-code-number",
  punctuation: "site-code-punctuation",
  comment: "site-code-comment",
  "tw-variant": "site-code-tw-variant",
  "tw-utility": "site-code-tw-utility",
  "tw-value": "site-code-tw-value",
  "tw-modifier": "site-code-tw-modifier",
};

const samples =
  typeof code === "string"
    ? [{ locale: undefined, lines: await highlight(code.trim(), lang) }]
    : await Promise.all(
        (["ko", "en"] as const).map(async (locale) => ({ locale, lines: await highlight(code[locale].trim(), lang) })),
      );
---

<figure class="not-prose flex flex-col gap-2">
  <figcaption class="flex items-center justify-between gap-4">
    <span class="font-mono text-caption text-text-secondary">{label}</span>
    <CopyButton client:visible code={code} />
  </figcaption>
  {
    samples.map(({ locale, lines }) => (
      <div data-locale-text={locale} lang={locale}>
        <CodePanel>
          {lines.map((line, index) => (
            <Fragment>
              {index > 0 && "\n"}
              {line.map((token) => (roleClass[token.role] ? <span class={roleClass[token.role]}>{token.content}</span> : token.content))}
            </Fragment>
          ))}
        </CodePanel>
      </div>
    ))
  }
</figure>
