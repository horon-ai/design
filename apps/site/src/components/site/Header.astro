---
import { externalLinks, primaryNav, isActive } from "@/data/nav";
import { mascotImageUrl } from "@/data/mascots";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-xl">
  <div class="shell flex h-16 items-center gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="HORON Design System 홈">
      <img
        src={mascotImageUrl("face")}
        alt=""
        width="30"
        height="30"
        class="size-[30px] object-contain"
      />
      <span class="text-[15px] font-semibold tracking-[-0.02em]">HORON</span>
      <span class="hidden text-[13px] font-normal text-muted-foreground sm:inline">Design System</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="주요 섹션">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(path, item.href) ? "page" : undefined}
            class:list={[
              "rounded-sm px-3 py-1.5 text-[13.5px] transition-colors",
              isActive(path, item.href)
                ? "bg-muted text-foreground"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-3">
      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            class="hidden rounded-sm px-2.5 py-1.5 text-[13px] text-muted-foreground transition-colors hover:text-foreground sm:block"
            target="_blank"
            rel="noreferrer"
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        data-theme-toggle
        class="grid size-8 place-items-center rounded-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="테마 전환"
      >
        <svg data-theme-icon="light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
        </svg>
        <svg data-theme-icon="dark" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="shell flex flex-wrap gap-1 border-t border-border py-2 md:hidden">
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(path, item.href) ? "page" : undefined}
          class:list={[
            "shrink-0 rounded-sm px-2 py-1 text-[12.5px] sm:px-2.5 sm:text-[13px]",
            isActive(path, item.href) ? "bg-muted text-foreground" : "text-muted-foreground",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script is:inline>
  const syncThemeIcons = () => {
    const dark = document.documentElement.classList.contains("dark");
    document.querySelectorAll("[data-theme-icon]").forEach((el) => {
      el.classList.toggle("hidden", el.getAttribute("data-theme-icon") !== (dark ? "dark" : "light"));
    });
  };
  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("horon-theme", dark ? "dark" : "light");
      } catch {}
      syncThemeIcons();
    });
  });
  syncThemeIcons();
</script>
