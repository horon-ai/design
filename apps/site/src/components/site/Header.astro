---
import { externalLinks, primaryNav, isActive } from "@/data/nav";
import { mascotImageUrl } from "@/data/mascots";
import SearchDialog from "@/components/site/SearchDialog.astro";

const path = Astro.url.pathname;
// The centre nav and the action cluster are placed on explicit columns because a
// display:none nav below md would otherwise let the cluster collapse into the
// middle track and pull the buttons away from the right edge.
---

<header class="fixed inset-x-0 top-0 z-50 h-16 bg-bg-default md:h-[4.75rem]">
  <div class="grid h-full grid-cols-[1fr_auto_1fr] items-center px-4">
    <a href="/" class="flex items-center gap-2.5 justify-self-start" aria-label="HORON Design System 홈">
      <img
        src={mascotImageUrl("face")}
        alt=""
        width="30"
        height="30"
        class="size-[30px] object-contain"
      />
      <span class="text-[15px] font-semibold tracking-[-0.02em]">HORON</span>
      <span class="hidden text-[13px] font-normal text-text-secondary sm:inline">Design System</span>
    </a>

    <nav class="col-start-2 hidden items-center gap-0.5 md:flex" aria-label="주요 섹션">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(path, item.href) ? "page" : undefined}
            class:list={[
              "inline-flex h-9 items-center rounded-lg px-3 text-body-md transition-colors",
              isActive(path, item.href)
                ? "bg-bg-subtle text-text-primary"
                : "text-text-secondary hover:text-text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="col-start-3 flex items-center gap-2 justify-self-end">
      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            class="hidden h-9 items-center rounded-lg px-3 text-body-sm text-text-secondary transition-colors hover:text-text-primary lg:inline-flex"
            target="_blank"
            rel="noreferrer"
          >
            {link.label}
          </a>
        ))
      }
      <SearchDialog />
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full bg-bg-subtle text-text-secondary transition-colors hover:text-text-primary"
        aria-label="테마 전환"
      >
        <svg data-theme-icon="light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
        </svg>
        <svg data-theme-icon="dark" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <button
        type="button"
        data-nav-toggle
        class="grid size-9 place-items-center rounded-full bg-bg-subtle text-text-secondary transition-colors hover:text-text-primary md:hidden"
        aria-label="메뉴"
        aria-expanded="false"
        aria-controls="site-mobile-nav"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="site-mobile-nav"
    data-mobile-panel
    hidden
    class="absolute inset-x-0 top-full border-b border-border-default bg-bg-default px-4 pb-4 md:hidden"
  >
    <nav class="flex flex-col" aria-label="주요 섹션">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(path, item.href) ? "page" : undefined}
            class:list={[
              "inline-flex h-10 items-center rounded-lg px-3 text-body-md transition-colors",
              isActive(path, item.href)
                ? "bg-bg-subtle text-text-primary"
                : "text-text-secondary hover:text-text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <nav class="mt-2 flex flex-col border-t border-border-default pt-2" aria-label="외부 링크">
      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex h-10 items-center rounded-lg px-3 text-body-md text-text-secondary transition-colors hover:text-text-primary"
            target="_blank"
            rel="noreferrer"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  const syncThemeIcons = () => {
    const dark = document.documentElement.classList.contains("dark");
    document.querySelectorAll("[data-theme-icon]").forEach((el) => {
      el.classList.toggle("hidden", el.getAttribute("data-theme-icon") !== (dark ? "dark" : "light"));
    });
  };
  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("horon-theme", dark ? "dark" : "light");
      } catch {}
      syncThemeIcons();
    });
  });
  syncThemeIcons();

  const navToggle = document.querySelector("[data-nav-toggle]");
  const mobilePanel = document.querySelector("[data-mobile-panel]");
  if (navToggle && mobilePanel) {
    const setPanelOpen = (open) => {
      mobilePanel.hidden = !open;
      navToggle.setAttribute("aria-expanded", open ? "true" : "false");
    };
    navToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setPanelOpen(mobilePanel.hidden);
    });
    document.addEventListener("click", (event) => {
      if (mobilePanel.hidden) return;
      if (mobilePanel.contains(event.target) || navToggle.contains(event.target)) return;
      setPanelOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || mobilePanel.hidden) return;
      setPanelOpen(false);
      navToggle.focus();
    });
  }
</script>
