---
import { HoronIcon, HoronWordmark } from "@horon-ai/react";

import T from "@/components/i18n/T.astro";
import { SiteHeaderBar } from "@/components/shell/SiteHeader";
import { shellMessages as m } from "@/components/shell/messages";

const pathname = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border-default bg-bg-default">
  <div class="flex h-16 items-center gap-3 px-4 md:h-19 md:px-6">
    {/* The brand link stays in Astro: it is plain navigation with no client
     * state, and the library has no lockup component that carries the wordmark. */}
    <a
      href="/"
      aria-label={m.home.ko}
      class="flex shrink-0 items-center gap-2.5 text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-brand"
    >
      <HoronIcon size={24} />
      <HoronWordmark />
      <span class="hidden text-body-sm text-text-secondary sm:inline"><T m={m.brandSuffix} /></span>
    </a>
    <SiteHeaderBar pathname={pathname} client:load />
  </div>
</header>
