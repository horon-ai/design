---
import { getDemo } from "@/lib/demos";

interface Props {
  name: string;
  layout?: "inline" | "grid";
  overlay?: boolean;
  minHeight?: string;
}

const { name, layout = "inline", overlay = false, minHeight } = Astro.props;
const Demo = getDemo(name);
---

<div
  class:list={[
    "demo-stage",
    layout === "grid" && "demo-stage-grid",
    overlay && "demo-stage-overlay",
    "not-prose",
  ]}
  style={minHeight ? `min-height: ${minHeight}` : undefined}
  data-demo={name}
>
  {Demo ? <Demo /> : <p class="text-[13px] text-muted-foreground">데모를 불러오지 못했습니다.</p>}
</div>
