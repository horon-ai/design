---
import T from "@/components/i18n/T.astro";
import { blockMessages } from "@/i18n/messages/blocks";
import { getDemo } from "@/lib/demos";

interface Props {
  name: string;
  layout?: "inline" | "grid";
  overlay?: boolean;
}

const { name, layout = "inline", overlay = false } = Astro.props;
const Demo = getDemo(name);
---

<div
  class:list={[
    "demo-stage",
    layout === "grid" && "demo-stage-grid",
    overlay && "demo-stage-overlay",
    "not-prose",
  ]}
  data-demo={name}
>
  {
    Demo ? (
      <Demo />
    ) : (
      <p class="text-body-sm text-text-secondary">
        <T m={blockMessages.demoUnavailable} />
      </p>
    )
  }
</div>
