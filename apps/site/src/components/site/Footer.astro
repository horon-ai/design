---
import { externalLinks, foundationsNav, primaryNav } from "@/data/nav";
import { mascotImageUrl } from "@/data/mascots";

const year = new Date().getFullYear();
const moreLinks = [...externalLinks, ...foundationsNav.slice(0, 4)];
const isExternal = (href: string) => href.startsWith("http");
---

<footer class="mt-12 border-t border-border-default pt-10">
  <div class="flex flex-col gap-10 md:flex-row md:justify-between">
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2.5">
        <img
          src={mascotImageUrl("wave")}
          alt=""
          width="36"
          height="36"
          loading="lazy"
          class="size-9 object-contain"
        />
        <p class="text-[15px] font-semibold tracking-[-0.02em]">HORON</p>
      </div>
      <p class="max-w-xs text-[13px] leading-6 text-text-secondary">
        데이터를 이해하는 것에서 끝나지 않고 실행과 결과까지 연결하는 AI 시스템. 그 시스템을
        지탱하는 디자인 언어입니다.
      </p>
      <p class="text-caption text-text-secondary">© {year} HORON. All rights reserved.</p>
    </div>

    <nav class="grid grid-cols-2 gap-x-12 gap-y-8">
      <div class="flex flex-col gap-3">
        <p class="text-caption text-text-secondary">Menu</p>
        <ul class="flex flex-col gap-2">
          {
            primaryNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-body-sm text-text-secondary transition-colors hover:text-text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-caption text-text-secondary">More</p>
        <ul class="flex flex-col gap-2">
          {
            moreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-body-sm text-text-secondary transition-colors hover:text-text-primary"
                  target={isExternal(link.href) ? "_blank" : undefined}
                  rel={isExternal(link.href) ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</footer>
