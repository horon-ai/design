---
import { externalLinks, foundationsNav, primaryNav } from "@/data/nav";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="text-[15px] font-semibold tracking-[-0.02em]">HORON</p>
      <p class="mt-3 max-w-xs text-[13px] leading-6 text-muted-foreground">
        데이터를 이해하는 것에서 끝나지 않고 실행과 결과까지 연결하는 AI 시스템. 그 시스템을
        지탱하는 디자인 언어입니다.
      </p>
    </div>
    <div>
      <p class="mb-3 font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground">Docs</p>
      <ul class="space-y-2">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] text-muted-foreground transition-colors hover:text-foreground">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mb-3 font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground">Foundations</p>
      <ul class="space-y-2">
        {
          foundationsNav.slice(1).map((item) => (
            <li>
              <a href={item.href} class="text-[13px] text-muted-foreground transition-colors hover:text-foreground">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mb-3 font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground">Links</p>
      <ul class="space-y-2">
        {
          externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[13px] text-muted-foreground transition-colors hover:text-foreground"
                target="_blank"
                rel="noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="shell flex flex-col gap-2 border-t border-border py-6 text-[12px] text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} HORON. All rights reserved.</p>
    <p>Rooted in Horon.</p>
  </div>
</footer>
