---
import "@/styles/site.css";
import Footer from "@/components/site/Footer.astro";
import Header from "@/components/site/Header.astro";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = "HORON Design System",
  description = "HORON 제품을 위한 토큰, 컴포넌트, 가이드. 디자인과 코드가 같은 값을 바라보게 만드는 디자인 시스템입니다.",
  wide = false,
} = Astro.props;
const pageTitle = title === "HORON Design System" ? title : `${title} — HORON Design System`;
---

<!doctype html>
<html lang="ko" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="256x256" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("horon-theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-full bg-background text-foreground antialiased">
    <Header />
    <main class={wide ? "" : "shell"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
