---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/site/Footer.astro";
import Sidebar from "@/components/site/Sidebar.astro";
import Toc from "@/components/site/Toc.astro";

interface Props {
  title: string;
  description?: string;
  section: string;
  eyebrow?: string;
  toc?: boolean;
  breadcrumb?: { label: string; href: string }[];
}

const { title, description, section, eyebrow, toc = true, breadcrumb } = Astro.props;
const sidebarSections = ["foundations", "components", "get-started", "updates"];
const withSidebar = sidebarSections.includes(section);
const showToc = toc && withSidebar;
const contentWidth = withSidebar ? "max-w-[56.25rem]" : "max-w-[68.75rem]";
---

<BaseLayout title={title} description={description} footer={false}>
  <div class:list={[withSidebar ? "docs-grid" : "block"]}>
    {withSidebar && <Sidebar section={section} />}
    <article class:list={[withSidebar ? "docs-main" : "docs-main-wide"]}>
      <div class:list={["mx-auto w-full", contentWidth]}>
        {
          breadcrumb && breadcrumb.length > 0 && (
            <nav
              aria-label="현재 위치"
              class="flex flex-wrap items-center gap-2 text-body-sm text-text-secondary"
            >
              {breadcrumb.map((item, index) => (
                <Fragment>
                  {index > 0 && <span aria-hidden="true">/</span>}
                  <a href={item.href} class="transition-colors hover:text-text-primary">
                    {item.label}
                  </a>
                </Fragment>
              ))}
            </nav>
          )
        }
        {eyebrow && <p class="mt-3 text-body-sm text-text-secondary">{eyebrow}</p>}
        <h1 class:list={[withSidebar ? "doc-title" : "doc-title doc-title-wide"]}>{title}</h1>
        {description && <p class="doc-lead mt-4">{description}</p>}
        <div class="prose-docs mt-10">
          <slot />
        </div>
        <Footer />
      </div>
    </article>
    {showToc && <Toc />}
  </div>
</BaseLayout>
