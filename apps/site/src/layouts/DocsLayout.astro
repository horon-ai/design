---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DocsBreadcrumb from "@/components/site/DocsBreadcrumb";
import DocsSidebar from "@/components/site/DocsSidebar";
import DocsToc from "@/components/site/DocsToc";
import Footer from "@/components/site/Footer.astro";
import T from "@/components/i18n/T.astro";
import { primaryNav } from "@/data/nav";
import type { Localized } from "@/i18n";
import { docsMessages } from "@/i18n/messages/docs";

export type DocsSection = "get-started" | "foundations" | "components" | "mascot" | "updates";

interface Props {
  /** Page title. A plain string is Korean-only; `Localized` renders both. */
  title: string | Localized;
  description?: string | Localized;
  section: DocsSection;
  /** `false` leaves the table of contents empty; its column stays so the text does not move. */
  toc?: boolean;
  /** Crumbs between the section and the page. Omit to get `Home / Section / Page`. */
  breadcrumb?: { label: string | Localized; href: string }[];
}

const { title, description, section, toc = true, breadcrumb } = Astro.props;

const both = (value: string | Localized): Localized =>
  typeof value === "string" ? { ko: value, en: value } : value;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const sectionHref = `/${section}`;
const sectionLabel = primaryNav.find((item) => item.href === sectionHref)?.label ?? both(section);

// Every docs page gets the same header rows (breadcrumb, title, lead), so the
// title sits at the same height on every page and nothing jumps on navigation.
const crumbs = [
  { label: docsMessages.home, href: "/" },
  ...(breadcrumb
    ? breadcrumb.map((item) => ({ label: both(item.label), href: item.href }))
    : [
        { label: sectionLabel, href: sectionHref },
        ...(currentPath === sectionHref ? [] : [{ label: both(title), href: currentPath }]),
      ]),
];
---

<BaseLayout title={title} description={description} footer={false}>
  <DocsSidebar section={section} currentPath={currentPath} client:load />

  <div class="flex items-start lg:ml-60">
    <article class="min-w-0 flex-1 px-4 pt-6 pb-16 md:px-6 md:pt-14 md:pb-24">
      <div class="mx-auto w-full max-w-225">
        <DocsBreadcrumb items={crumbs} client:load />

        <header>
          <h1 class="text-display-md text-text-primary text-balance">
            {typeof title === "string" ? title : <T m={title} />}
          </h1>
          {
            description && (
              <p class="mt-4 max-w-3xl text-body-lg text-text-secondary">
                {typeof description === "string" ? description : <T m={description} />}
              </p>
            )
          }
        </header>

        <div class="prose-docs mt-10">
          <slot />
        </div>

        <Footer />
      </div>
    </article>

    {/* Reserved on every docs page from xl, filled or not, so the text column never shifts. */}
    <aside class="hidden xl:sticky xl:top-19 xl:block xl:max-h-dvh xl:w-50 xl:shrink-0 xl:self-start xl:overflow-y-auto xl:pt-14 xl:pr-4 xl:pb-19">
      {toc && <DocsToc client:load />}
    </aside>
  </div>
</BaseLayout>
