---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DocsBreadcrumb from "@/components/site/DocsBreadcrumb";
import DocsSidebar from "@/components/site/DocsSidebar";
import DocsToc from "@/components/site/DocsToc";
import T from "@/components/i18n/T.astro";
import { primaryNav } from "@/data/nav";
import { siteHref } from "@/lib/urls";
import type { Localized } from "@/i18n";
import { docsMessages } from "@/i18n/messages/docs";

export type DocsSection = "get-started" | "foundations" | "components" | "develop" | "mascot" | "updates";

interface Props {
  /** Page title. A plain string is Korean-only; `Localized` renders both. */
  title: string | Localized;
  description?: string | Localized;
  section: DocsSection;
  /** `false` drops the table of contents and its column. */
  toc?: boolean;
  /** Overview pages (a catalog grid) use the whole column instead of the 900px reading width, with no TOC. */
  wide?: boolean;
  /** Crumbs between the section and the page. Omit to get `Home / Section / Page`. */
  breadcrumb?: { label: string | Localized; href: string }[];
}

const { title, description, section, toc = true, wide = false, breadcrumb } = Astro.props;
const showToc = toc && !wide;

const both = (value: string | Localized): Localized =>
  typeof value === "string" ? { ko: value, en: value } : value;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const sectionHref = `/${section}`;
const sectionLabel = primaryNav.find((item) => item.href === sectionHref)?.label ?? both(section);

// Every docs page gets the same header rows (breadcrumb, title, lead), so the
// title sits at the same height on every page and nothing jumps on navigation.
const crumbs = [
  { label: docsMessages.home, href: "/" },
  ...(breadcrumb
    ? breadcrumb.map((item) => ({ label: both(item.label), href: siteHref(item.href) }))
    : [
        { label: sectionLabel, href: siteHref(sectionHref) },
        ...(currentPath === sectionHref ? [] : [{ label: both(title), href: siteHref(currentPath) }]),
      ]),
];
---

<BaseLayout title={title} description={description}>
  {/* One frame for every docs page, capped at `--site-max` and centered like the
   * header row above it: a sticky 240px sidebar, the article, and the TOC rail
   * from `xl`. Reading pages keep a 900px column on the article's left edge, so
   * the title sits at the same x on every page; overview pages use the full
   * article width. Below `lg` the sidebar collapses into a disclosure above the
   * article, so the frame stacks. */}
  <div class="mx-auto w-full max-w-(--site-max) lg:flex lg:items-start">
    <DocsSidebar section={section} currentPath={currentPath} client:load />

    <article class="docs-main min-w-0 flex-1">
      <div class:list={[!wide && "max-w-225"]}>
        <DocsBreadcrumb items={crumbs} client:load />

        <header>
          <h1 class="text-display-md text-text-primary text-balance">
            {typeof title === "string" ? title : <T m={title} />}
          </h1>
          {
            description && (
              <p class="mt-4 max-w-3xl text-body-lg text-text-secondary">
                {typeof description === "string" ? description : <T m={description} />}
              </p>
            )
          }
        </header>

        {/* Below `xl` the TOC rail is hidden, and below `md` the section sidebar is
         * too, so the same list appears as a collapsed block under the title.
         * `DocsToc` renders nothing until the article has two or more headings. */}
        {showToc && <DocsToc inline client:media="(max-width: 767px)" />}

        <div class="prose-docs mt-10">
          <slot />
        </div>
      </div>
    </article>

    {
      showToc && (
        <aside class="hidden xl:sticky xl:top-(--site-header-h) xl:block xl:max-h-[calc(100dvh-var(--site-header-h))] xl:w-50 xl:shrink-0 xl:self-start xl:overflow-y-auto xl:pt-14 xl:pr-6 xl:pb-14">
          <DocsToc client:load />
        </aside>
      )
    }
  </div>
</BaseLayout>
