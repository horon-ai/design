	},
	"devDependencies": {
		"@tailwindcss/vite": "^4",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"typescript": "~6.0.3",
		"vite": "^8"
	}
